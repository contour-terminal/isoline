;; Every defvaltype, function types, component and instance types, resources and outer aliases.
(component $outer
  (type $b bool) (type s8) (type u8) (type s16) (type u16) (type s32) (type u32) (type s64) (type u64)
  (type f32) (type f64) (type float32) (type float64) (type char) (type string) (type error-context)
  (type $rec (record (field "x" u8) (field "y" $b)))
  (type (variant (case $c0 "a") (case "b" u8)))
  (type (list u8)) (type (list u8 4)) (type (tuple u8 u16)) (type (flags "a" "b")) (type (enum "x" "y"))
  (type (option string)) (type (result)) (type (result u8)) (type (result (error u8))) (type (result u8 (error u16)))
  (type $res (resource (rep i32)))
  (type (own $res)) (type (borrow $res))
  (type (stream)) (type (stream u8)) (type (future)) (type (future string)) (type (map string u32))
  (type (func async (param "a" u8) (result string)))
  (type $ct (component
    (core type $cmt (module (import "a" "b" (func)) (export "c" (global (mut i32)))))
    (type $inner u8)
    (alias outer $outer $rec (type $from-outer))
    (alias outer 1 0 (type))
    (import "f" (func (param "p" $inner)))
    (import "m" (core module (type $cmt)))
    (import "t" (type (eq $inner)))
    (import "r" (type (sub resource)))
    (export "e" (instance
      (type $in u16)
      (alias outer $ct $inner (type))
      (export "g" (func (result $in)))
      (export "use-outer" (type (eq $rec)))))))
  (type (instance (export "i" (func))))
  (core type (module
    (type $t (func (param i32) (result i32)))
    (type (func (param i64)))
    (alias outer $outer 0 (type $aliased))
    (import "m" "f" (func (type $t)))
    (import "m" "g" (func (param i32) (result i32)))
    (import "m" "h" (func (param f32)))
    (import "m" "t" (table 1 10 funcref))
    (import "m" "mem" (memory i64 1 2))
    (import "m" "small" (memory 1 (pagesize 1)))
    (import "m" "g2" (global i64))
    (import "m" "tag" (tag (param i32)))
    (export "e" (func (param f32)))))
  (core type (func (param i32 i64) (result f32 f64 v128 funcref externref)))
  (component $nested
    (type $local (list $rec))
    (alias outer $outer $res (type $res-again))))
