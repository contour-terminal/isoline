;; Canonical built-ins and options, by their text names.
(component
  (core module $m
    (memory (export "mem") 1)
    (table (export "tab") 1 funcref)
    (func (export "f") (param i32) (result i32) (local.get 0))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 0)))
  (core instance $i (instantiate $m))
  (core type $ft (func (param i32)))
  (type $res (resource (rep i32) (dtor (core func $i "f"))))
  (type $s (stream u8))
  (type $fu (future))
  (type $fn (func (param "x" string) (result string)))
  (func $lifted (type $fn)
    (canon lift (core func $i "f") (memory (core memory $i "mem")) (realloc (core func $i "realloc")) string-encoding=utf8 (post-return (core func $i "f"))))
  (canon lift (core func $i "f") string-encoding=utf16 (memory (core memory $i "mem")) (func $l2 (type $fn)))
  (canon lift (core func $i "f") string-encoding=latin1+utf16 async (callback (core func $i "f")) (func (param "y" u32)))
  (canon lower (func $lifted) (memory (core memory $i "mem")) (core func $low))
  (canon resource.new $res (core func))
  (canon resource.drop (type $res) (core func))
  (canon resource.rep $res (core func))
  (canon backpressure.inc (core func))
  (canon backpressure.dec (core func))
  (canon task.return (result string) (memory (core memory $i "mem")) string-encoding=utf8 (core func))
  (canon task.return (core func))
  (canon task.cancel (core func))
  (canon context.get i32 0 (core func))
  (canon context.set i32 1 (core func))
  (canon subtask.cancel async (core func))
  (canon subtask.cancel (core func))
  (canon subtask.drop (core func))
  (canon stream.new $s (core func))
  (canon stream.read $s (memory (core memory $i "mem")) (core func))
  (canon stream.write $s async (memory (core memory $i "mem")) (core func))
  (canon stream.cancel-read $s async (core func))
  (canon stream.cancel-write $s (core func))
  (canon stream.drop-readable $s (core func))
  (canon stream.drop-writable $s (core func))
  (canon future.new $fu (core func))
  (canon future.read $fu (memory (core memory $i "mem")) (core func))
  (canon future.write $fu (memory (core memory $i "mem")) (core func))
  (canon future.cancel-read $fu (core func))
  (canon future.cancel-write $fu async (core func))
  (canon future.drop-readable $fu (core func))
  (canon future.drop-writable $fu (core func))
  (canon waitable-set.new (core func))
  (canon waitable-set.wait (memory (core memory $i "mem")) (core func))
  (canon waitable-set.poll (memory (core memory $i "mem")) (core func))
  (canon waitable-set.drop (core func))
  (canon waitable.join (core func))
  (canon thread.yield (core func))
  (core func (canon lower (func $l2)))
  (core instance (export "f" (func $low)) (export "m" (memory $i "mem")) (export "t" (table $i "tab")))
  (@custom "my-section" "payload" "\00\01")
  (export "lifted" (func $lifted) (func (type $fn)))
  (export "res" (type $res))
  (import "attributed" (implements "wasi:cli/run@0.2.0") (instance))
  (import (interface "legacy:pkg/iface") (func)))
