;; Forms the other fixtures leave out: inline imports, core func aliases, attributes, reference types.
(component $more
  (core module $imported (import "core-module") (type 0))
  (core module $inline-type (import "core-module-2") (import "a" "b" (func)) (export "c" (memory 1 2)))
  (instance $imported-instance (import "instance") (type 1))
  (instance $inline-instance (import "instance-2") (export "f" (func)))
  (func $imported-func (import "func") (param "a" u8))
  (func $imported-typed (import "func-2") (type 2))
  (component $imported-component (import "component") (import "x" (func)))
  (core instance $ci (instantiate $inline-type))
  (core func $aliased (alias core export $ci "c"))
  (core type $refs (func (param (ref null func) (ref extern) (ref 0) (ref null 0)) (result exnref)))
  (core type (module
    (type $t (func))
    (type $t2 (func))
    (import "a" "b" (func))
    (import "a" "c" (table i64 1 2 (ref null func)))
    (import "a" "d" (global (mut (ref null 0))))
    (export "e" (tag (type $t)))))
  (import "attributes" (implements "a:b/c") (external-id "id") (instance))
  (import "suffixed" (version-suffix "-rc1") (func))
  (type $named (@name "annotated") u8)
  (component (@name "inner-annotated"))
  (canon thread.new-indirect 0 0 (core func))
  (canon error-context.new (memory 0) (core func))
  (canon error-context.debug-message (core func))
  (canon error-context.drop (core func))
  (canon thread.index (core func))
  (canon thread.resume-later (core func))
  (canon thread.suspend (core func))
  (canon thread.suspend-then-resume (core func))
  (canon thread.yield-then-resume (core func))
  (canon thread.suspend-then-promote (core func))
  (canon thread.yield-then-promote (core func))
  (canon stream.forward 0 (core func))
  (canon future.forward 0 (core func))
  (func (export (interface "legacy:inline/export")) (alias export $imported-instance "f"))
  (type (list (own $named)))
  (@unknown annotation is ignored)
  (type $aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa u8)
  (core module (func $named-func) (@custom "module-custom" "x"))
  (export "ascribed-component" (component $imported-component) (component (type 3)))
  (export "ascribed-module" (core module $imported) (core module (type 0))))
