# SPDX-License-Identifier: Apache-2.0
#
# c-headers-standalone: every header of the C API compiles alone, in each language and standard a
# consumer may compile it as, under the warning set the C API promises (plan P17a, D9), with -Werror or
# /WX. One test per header and row, c-headers-standalone.<header>.<row>.
#
# Each test compiles a generated translation unit that includes the one header, as an object library of
# its own that CMake builds with the preset's toolchain, so a row runs on whatever compiler the tree is
# configured for: GCC and Clang, clang-cl (clangcl-cross-debug) and real MSVC under wine
# (msvc-wine-debug), which differ on what they accept (a calling convention in WASM_API_EXTERN's
# position is C2143 on MSVC, accepted by clang-cl). The libraries are EXCLUDE_FROM_ALL, so a header that
# breaks a row fails its test rather than the build; each test builds its library, holding the build
# tree's lock so that no two builds of the one tree run at once.

include_guard(GLOBAL)

# The rows: row|language|standard|definitions. A row is a language, the standard CMake compiles it as,
# and the definitions a consumer compiles with, comma-separated: c11-static is a program linking the
# static library (ISOLINE_C_STATIC, LIBWASM_STATIC, as pkg-config's Cflags.private say), whose
# declarations carry no import annotation.
set(ISOLINE_C_HEADER_LINT_ROWS
    "c11|C|11|"
    "c17|C|17|"
    "c11-static|C|11|ISOLINE_C_STATIC,LIBWASM_STATIC"
    "cxx23|CXX|23|")

# The warning set, by the compiler's front end and the language: frontend|language|flags. The GNU set
# is the C API's (ISOLINE_C_API_GNU_WARNINGS, cmake/IsolinePedantic.cmake); C++ takes it without the
# flags that are C's alone.
set(_isolineHeaderLintCOnlyFlags -Wstrict-prototypes -Wmissing-prototypes)
set(_isolineHeaderLintGnuCxxFlags ${ISOLINE_C_API_GNU_WARNINGS})
list(REMOVE_ITEM _isolineHeaderLintGnuCxxFlags ${_isolineHeaderLintCOnlyFlags})
list(JOIN ISOLINE_C_API_GNU_WARNINGS "," _isolineHeaderLintGnuC)
list(JOIN _isolineHeaderLintGnuCxxFlags "," _isolineHeaderLintGnuCxx)
set(ISOLINE_C_HEADER_LINT_WARNING_ROWS
    "GNU|C|${_isolineHeaderLintGnuC},-Werror"
    "GNU|CXX|${_isolineHeaderLintGnuCxx},-Werror"
    "MSVC|C|/W4,/WX"
    "MSVC|CXX|/W4,/WX")

## @brief Registers c-headers-standalone.<header>.<row> for each header and row.
##
## isoline_c_header_lint(HEADERS <include name>... INCLUDE_DIRECTORIES <directory>...)
## An include name is what a consumer writes between the angle brackets (isoline/c/abi.h, wasm.h).
function(isoline_c_header_lint)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "" "HEADERS;INCLUDE_DIRECTORIES")
    set(unitDirectory "${CMAKE_CURRENT_BINARY_DIR}/header-lint")
    foreach(header IN LISTS arg_HEADERS)
        get_filename_component(headerName "${header}" NAME)
        string(MAKE_C_IDENTIFIER "${headerName}" headerIdentifier)
        foreach(row IN LISTS ISOLINE_C_HEADER_LINT_ROWS)
            string(REPLACE "|" ";" row "${row}")
            list(GET row 0 rowName)
            list(GET row 1 language)
            list(GET row 2 standard)
            list(GET row 3 definitions)
            string(REPLACE "," ";" definitions "${definitions}")
            if(language STREQUAL "C")
                set(extension c)
            else()
                set(extension cpp)
            endif()
            set(frontend GNU)
            if(CMAKE_${language}_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
                set(frontend MSVC)
            endif()
            set(warnings "")
            foreach(warningRow IN LISTS ISOLINE_C_HEADER_LINT_WARNING_ROWS)
                if(warningRow MATCHES "^${frontend}[|]${language}[|](.+)$")
                    string(REPLACE "," ";" warnings "${CMAKE_MATCH_1}")
                endif()
            endforeach()
            if(NOT warnings)
                message(FATAL_ERROR "HeaderLint: no warning row for ${frontend} ${language}")
            endif()

            # The header and one declaration of the unit's own: a unit of macros alone (export.h) would
            # otherwise be empty, which ISO C does not allow.
            set(unit "${unitDirectory}/${headerIdentifier}_${rowName}.${extension}")
            file(CONFIGURE OUTPUT "${unit}" CONTENT
                 "/* Generated by tests/c/HeaderLint.cmake: <${header}> alone, as ${rowName}. */\n#include <${header}>\ntypedef int isoline_header_lint_unit_t;\n")
            set(target "isoline_header_lint_${headerIdentifier}_${rowName}")
            add_library(${target} OBJECT EXCLUDE_FROM_ALL "${unit}")
            target_include_directories(${target} PRIVATE ${arg_INCLUDE_DIRECTORIES})
            target_compile_options(${target} PRIVATE ${warnings})
            target_compile_definitions(${target} PRIVATE ${definitions})
            set_target_properties(${target} PROPERTIES
                ${language}_STANDARD ${standard}
                ${language}_STANDARD_REQUIRED ON
                ${language}_EXTENSIONS OFF)
            set(test "c-headers-standalone.${headerName}.${rowName}")
            add_test(NAME ${test}
                     COMMAND "${CMAKE_COMMAND}" --build "${PROJECT_BINARY_DIR}" --target ${target} --config $<CONFIG>)
            set_tests_properties(${test} PROPERTIES LABELS lint RESOURCE_LOCK isoline-build-tree)
        endforeach()
    endforeach()
endfunction()
