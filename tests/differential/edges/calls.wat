;; Calls to the store's call depth and past it: plain recursion, tail calls, indirect calls through a table
;; that is short and holds a null, calls through a reference, and a loop that spends the steps.
(module
  (type $r (func (param i32) (result i32)))
  (table 3 funcref)
  (elem (i32.const 0) func $recurse $tail)
  (func $recurse (export "recurse") (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (i32.const 0))
      (else (i32.add (i32.const 1) (call $recurse (i32.sub (local.get 0) (i32.const 1)))))))
  (func $tail (export "tail") (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (i32.const 7))
      (else (return_call $tail (i32.sub (local.get 0) (i32.const 1))))))
  (func $indirect (export "indirect") (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (i32.const 1))
      (else (call_indirect (type $r)
              (i32.sub (local.get 0) (i32.const 1))
              (i32.and (local.get 0) (i32.const 3))))))
  (func (export "tailIndirect") (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (i32.const 2))
      (else (return_call_indirect (type $r) (i32.sub (local.get 0) (i32.const 1)) (i32.const 1)))))
  (func (export "byReference") (param i32) (result i32)
    (call_ref $r (local.get 0) (ref.func $recurse)))
  (func (export "spin") (param i32) (result i32) (local i32)
    (loop $again
      (local.set 1 (i32.add (local.get 1) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get 1) (local.get 0))))
    (local.get 1))
  (func (export "spinForever") (loop $again (br $again)))
)
