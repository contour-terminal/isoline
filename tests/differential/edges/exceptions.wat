;; Exceptions thrown through many frames, caught by tags and by catch_all, rethrown from a local, thrown out
;; of the call, a null throw_ref, and enough of them to fill the store's exception arena, so that sweeps run.
;; One throw unwinds five labels a frame through 600 to 855 frames: past UnwindPollItems, so unwinding polls.
(module
  (tag $value (param i32))
  (tag $empty)
  (func $throwAfter (param i32)
    (if (i32.eqz (local.get 0)) (then (throw $value (i32.const 42))))
    (call $throwAfter (i32.sub (local.get 0) (i32.const 1))))
  (func (export "deep") (param i32) (result i32)
    (block $caught (result i32)
      (try_table (catch $value $caught)
        (call $throwAfter (i32.and (local.get 0) (i32.const 2047))))
      (i32.const -1)))
  (func $nested (param i32)
    (block (block (block (block (block
      (if (i32.eqz (local.get 0)) (then (throw $value (i32.const 1))))
      (call $nested (i32.sub (local.get 0) (i32.const 1)))))))))
  (func (export "unwindFar") (param i32) (result i32)
    (block $caught (result i32)
      (try_table (catch $value $caught)
        (call $nested (i32.add (i32.const 600) (i32.and (local.get 0) (i32.const 255)))))
      (i32.const -1)))
  (func (export "escape") (param i32) (throw $value (local.get 0)))
  (func (export "rethrow") (param i32) (result i32) (local exnref)
    (local.set 1
      (block $caught (result exnref)
        (try_table (catch_all_ref $caught) (throw $empty))
        (unreachable)))
    (if (local.get 0) (then (throw_ref (local.get 1))))
    (i32.const 3))
  (func (export "nullThrow") (throw_ref (ref.null exn)))
  (func $churn (export "churn") (param i32) (result i32) (local i32)
    (loop $again
      (block $caught (try_table (catch_all $caught) (throw $value (local.get 1))))
      (local.set 1 (i32.add (local.get 1) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get 1) (i32.and (local.get 0) (i32.const 1023)))))
    (local.get 1))
  (func (export "holdThenChurn") (param i32) (result i32) (local exnref)
    (block $caught (result i32 exnref)
      (try_table (catch_ref $value $caught) (throw $value (local.get 0)))
      (unreachable))
    (local.set 1)
    (drop)
    (drop (call $churn (local.get 0)))
    (block $kept (result i32)
      (try_table (catch $value $kept) (throw_ref (local.get 1)))
      (i32.const -1)))
  (func (export "catchToLoop") (param i32) (result i32) (local i32)
    (loop $again
      (local.set 1 (i32.add (local.get 1) (i32.const 1)))
      (if (i32.lt_u (local.get 1) (local.get 0))
        (then (try_table (catch_all $again) (throw $empty)))))
    (local.get 1))
)
