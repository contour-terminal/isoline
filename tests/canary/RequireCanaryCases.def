//
// The canary's cases, one per line: ISOLINE_REQUIRE_CANARY_CASE(function, "name", spelling, "check"). The function
// (RequireCanary.cpp) calls what must fail its check; the name is the command-line argument that runs it, and
// the CTest it becomes (isoline_require_canary.<name>); the spelling is how the check that fires first is
// written where contracts are native: `require` (Require()), `contract` (ISOLINE_PRECONDITION or
// ISOLINE_INVARIANT), `pre` or `post` (ISOLINE_PRE or ISOLINE_POST on the function's declaration); the check is
// the CMake regular expression of the condition text the test must print, on both paths. A `pre` keeps its
// body check, which the fallback path reports; a `post` has none, so the fallback lets the call through. RequireCanary.cpp includes this file for its case
// table, and tests/CMakeLists.txt reads it for the tests: one list, so the two cannot drift.
ISOLINE_REQUIRE_CANARY_CASE(engineOfOpenFeatureSet, "engine-open-features", pre, "_?config[.]features[.]checkPrerequisites[(][)][.]has_value[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(functionStoreAfterDelete, "function-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(functionTypeAfterDelete, "function-type-after-delete", pre, "_link[.]isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(memoryStoreAfterDelete, "memory-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(globalStoreAfterDelete, "global-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(tableStoreAfterDelete, "table-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(tagStoreAfterDelete, "tag-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(tagTypeAfterDelete, "tag-type-after-delete", pre, "_link[.]isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsInstanceAfterDelete, "imports-instance-after-delete", require, "instance[.]isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsFunctionAfterDelete, "imports-function-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsMemoryAfterDelete, "imports-memory-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsHostTypeConcrete, "imports-host-type-concrete", require, "Store::checkHostFunctionType[(]type[)][.]has_value[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsHostTypeBottom, "imports-host-type-bottom", require, "Store::checkHostFunctionType[(]type[)][.]has_value[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(hostMemoryStoreAfterDelete, "host-memory-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(hostTableStoreAfterDelete, "host-table-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(hostGlobalStoreAfterDelete, "host-global-store-after-delete", pre, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(normalizeAnchorOutOfRange, "normalize-anchor-out-of-range", contract, "anchor <= LastSectionAnchor")
ISOLINE_REQUIRE_CANARY_CASE(storeDefineNullFunction, "store-define-null-function", contract, "function != nullptr")
ISOLINE_REQUIRE_CANARY_CASE(threadPreparationOfNothing, "thread-preparation-of-nothing", contract, "_resource != nullptr")
ISOLINE_REQUIRE_CANARY_CASE(byteReaderOffsetWraps, "byte-reader-offset-wraps", post, "absolute >= _baseOffset")
// The positions a contract-spelled check must be evaluated in (CheckPositions.hpp), both macros.
ISOLINE_REQUIRE_CANARY_CASE(positionPreconditionFirst, "precondition-first", contract, "entryRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionPreconditionInBracelessIf, "precondition-in-braceless-if", contract, "ifRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInBracelessElse, "invariant-in-braceless-else", contract, "elseRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInForBody, "invariant-in-for-body", contract, "forRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInWhileBody, "invariant-in-while-body", contract, "whileRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInDoBody, "invariant-in-do-body", contract, "doRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInRangeForBody, "invariant-in-range-for-body", contract, "rangeRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInNoexceptLambdaInTry, "invariant-in-noexcept-lambda-in-try", contract, "lambdaRounds == 0")
