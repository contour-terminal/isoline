//
// The canary's cases, one per line: ISOLINE_REQUIRE_CANARY_CASE(function, "name", contract, "check"). The function
// (RequireCanary.cpp) calls what must fail its Require(); the name is the command-line argument that runs
// it, and the CTest it becomes (isoline_require_canary.<name>); the check is the CMake regular expression
// of the Require()'s condition text the test must print. RequireCanary.cpp includes this file for its case
// table, and tests/CMakeLists.txt reads it for the tests: one list, so the two cannot drift.
ISOLINE_REQUIRE_CANARY_CASE(engineOfOpenFeatureSet, "engine-open-features", contract, "_config[.]features[.]checkPrerequisites[(][)][.]has_value[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(functionStoreAfterDelete, "function-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(functionTypeAfterDelete, "function-type-after-delete", contract, "_link[.]isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(memoryStoreAfterDelete, "memory-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(globalStoreAfterDelete, "global-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(tableStoreAfterDelete, "table-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(tagStoreAfterDelete, "tag-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(tagTypeAfterDelete, "tag-type-after-delete", contract, "_link[.]isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsInstanceAfterDelete, "imports-instance-after-delete", require, "instance[.]isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsFunctionAfterDelete, "imports-function-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsMemoryAfterDelete, "imports-memory-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsHostTypeConcrete, "imports-host-type-concrete", require, "Store::checkHostFunctionType[(]type[)][.]has_value[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(importsHostTypeBottom, "imports-host-type-bottom", require, "Store::checkHostFunctionType[(]type[)][.]has_value[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(hostMemoryStoreAfterDelete, "host-memory-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(hostTableStoreAfterDelete, "host-table-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(hostGlobalStoreAfterDelete, "host-global-store-after-delete", contract, "isAlive[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(normalizeAnchorOutOfRange, "normalize-anchor-out-of-range", contract, "anchor <= LastSectionAnchor")
ISOLINE_REQUIRE_CANARY_CASE(storeDefineNullFunction, "store-define-null-function", contract, "function != nullptr")
ISOLINE_REQUIRE_CANARY_CASE(threadPreparationOfNothing, "thread-preparation-of-nothing", contract, "_resource != nullptr")
// The platform layer: virtual memory and the platform rows (src/isoline/platform/).
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryReserveNothing, "virtual-memory-reserve-nothing", contract, "bytes > 0")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryReservePartGranule, "virtual-memory-reserve-part-granule", contract, "bytes % granularity == 0")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryProtectNothing, "virtual-memory-protect-nothing", contract, "region[.]bytes > 0")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryProtectPartPage, "virtual-memory-protect-part-page", contract, "region[.]bytes % pageSize == 0")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryReleaseUnaligned, "virtual-memory-release-unaligned", contract, "reinterpret_cast<uintptr_t>[(]region[.]base[)] % pageSize == 0")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryReleasePart, "virtual-memory-release-part", contract, "region == reservation")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryRefusedProtectNothing, "virtual-memory-refused-protect-nothing", contract, "region[.]bytes > 0")
ISOLINE_REQUIRE_CANARY_CASE(virtualMemoryForeignDecommit, "virtual-memory-foreign-decommit", contract, "decommitsOnThisSystem[(]decommit[)]")
ISOLINE_REQUIRE_CANARY_CASE(protectionRowOutOfRange, "protection-row-out-of-range", require, "std::to_underlying[(]protection[)] < ProtectionTable[.]size[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(platformRowOutOfRange, "platform-row-out-of-range", require, "std::to_underlying[(]architecture[)] <= std::to_underlying[(]LastArchitecture[)]")
// JIT memory and the instruction cache (src/isoline/platform/).
ISOLINE_REQUIRE_CANARY_CASE(jitMappingWritableExecutableWithoutToggle, "jit-mapping-writable-executable-without-toggle", contract, "allowsJitMapping[(]kind, mapping[)]")
ISOLINE_REQUIRE_CANARY_CASE(jitAccessWithoutToggle, "jit-access-without-toggle", contract, "togglesJitPerThread[(]kind[)]")
ISOLINE_REQUIRE_CANARY_CASE(jitReleaseWithoutMapJit, "jit-release-without-map-jit", contract, "allowsJitMapping[(]kind, mapping[)]")
ISOLINE_REQUIRE_CANARY_CASE(jitScopeEndedOnAnotherThread, "jit-scope-ended-on-another-thread", contract, "std::this_thread::get_id[(][)] == _owner")
ISOLINE_REQUIRE_CANARY_CASE(codeMemoryRowOutOfRange, "code-memory-row-out-of-range", require, "std::to_underlying[(]kind[)] < CodeMemoryTable[.]size[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(jitMappingOutOfRange, "jit-mapping-out-of-range", require, "std::to_underlying[(]mapping[)] < JitMappingTable[.]size[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(instructionCacheRowOutOfRange, "instruction-cache-row-out-of-range", require, "std::to_underlying[(]kind[)] < InstructionCacheTable[.]size[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(instructionCacheWithoutMaintenance, "instruction-cache-without-maintenance", contract, "_maintenance != nullptr")
// The memory layout's bounds strategies and store requirements (src/isoline/runtime/MemoryLayout.cpp).
ISOLINE_REQUIRE_CANARY_CASE(memoryLayoutGuardAboveMaximum, "memory-layout-guard-above-maximum", contract, "!layout[.]has_value[(][)] [|][|] isWellFormed[(][*]layout[)]")
ISOLINE_REQUIRE_CANARY_CASE(memoryRequirementsReachOverflows, "memory-requirements-reach-overflows", contract, "!layout[.]has_value[(][)] [|][|] isWellFormed[(][*]layout[)]")
ISOLINE_REQUIRE_CANARY_CASE(layoutOfPageSizeNotAPower, "layout-of-page-size-not-a-power", contract, "std::has_single_bit[(]pageSize[)]")
ISOLINE_REQUIRE_CANARY_CASE(layoutOfCapPastTheReach, "layout-of-cap-past-the-reach", contract, "maxMemoryBytes <= std::numeric_limits<uint64_t>::max[(][)] - MaximumGuardBytes - pageSize")
ISOLINE_REQUIRE_CANARY_CASE(layoutOfRowOutOfRange, "layout-of-row-out-of-range", contract, "std::to_underlying[(]row[)] < MemoryLayoutTable[.]size[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(storeFaultAtomicityOutOfRange, "store-fault-atomicity-out-of-range", contract, "std::to_underlying[(]architecture[)] < StoreFaultAtomicityTable[.]size[(][)]")
ISOLINE_REQUIRE_CANARY_CASE(memoryAccessSizeNotAPower, "memory-access-size-not-a-power", contract, "std::has_single_bit[(]access[.]size[)] && access[.]size <= MaximumAccessBytes")
ISOLINE_REQUIRE_CANARY_CASE(memoryAccessTooWide, "memory-access-too-wide", contract, "std::has_single_bit[(]access[.]size[)] && access[.]size <= MaximumAccessBytes")
ISOLINE_REQUIRE_CANARY_CASE(storeGrowBelowTheGuard, "store-grow-below-the-guard", require, "provides[(][*]instance[.]_memory, memoryRequirementsFor[(]_guardPageLayout, instance[.]type[)][)]")
ISOLINE_REQUIRE_CANARY_CASE(storeOfIllFormedLayout, "store-of-ill-formed-layout", require, "!services[.]guardPageLayout[.]has_value[(][)] [|][|] isWellFormed[(][*]services[.]guardPageLayout[)]")
// The positions a contract-spelled check must be evaluated in (CheckPositions.hpp), both macros.
ISOLINE_REQUIRE_CANARY_CASE(positionPreconditionFirst, "precondition-first", contract, "entryRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionPreconditionInBracelessIf, "precondition-in-braceless-if", contract, "ifRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInBracelessElse, "invariant-in-braceless-else", contract, "elseRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInForBody, "invariant-in-for-body", contract, "forRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInWhileBody, "invariant-in-while-body", contract, "whileRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInDoBody, "invariant-in-do-body", contract, "doRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInRangeForBody, "invariant-in-range-for-body", contract, "rangeRounds == 0")
ISOLINE_REQUIRE_CANARY_CASE(positionInvariantInNoexceptLambdaInTry, "invariant-in-noexcept-lambda-in-try", contract, "lambdaRounds == 0")
