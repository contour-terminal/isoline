// SPDX-License-Identifier: Apache-2.0
// Generated by CMake from src/isoline/meta/reflection/ContractsProof.hpp.in, where contracts are native,
// into a directory that only the reflection check isoline_declaration_contracts_check (and the
// compile-fail tests of its refusal) put before the installed headers' (docs/language-features.md,
// "Declaration contracts"). Never installed, and never compiled into an object anything links.
//
// The proving expansion of isoline/Contracts.hpp: each ISOLINE_PRE and ISOLINE_POST carries a first `pre`
// that refuses, at compile time, a function that may throw. The check reads every header with it, so
// every declaration contract is proven to sit on a noexcept member function, while the installed
// expansion stays `pre(condition)` alone, which a consumer compiles without reflection.
#pragma once

#include <meta>

/// 1: the declarations carry C++26 contracts, as the native isoline/Contracts.hpp says.
#define ISOLINE_DECLARATION_CONTRACTS 1

namespace isoline::meta::detail
{

/// The mode's own namespace: a translation unit compiled against this header names the mode its package
/// was built in, so that objects of a native and a fallback package mixed in one program do not link.
inline namespace declaration_contracts_1
{

    /// The package's mode, ISOLINE_DECLARATION_CONTRACTS, as the library built in it defines it
    /// (src/isoline/Contracts.cpp); a library of the other mode defines another symbol.
    /// @return ISOLINE_DECLARATION_CONTRACTS.
    [[nodiscard]] int declarationContractsMode() noexcept;

    /// Read by every translation unit that sees a declaration contract (includes this header), so that each
    /// references the mode's symbol. Inside the mode's namespace, so that the two modes' copies are two
    /// names, and a linker that keeps one copy of each still keeps both references. A constant
    /// initializer where the compiler can be told to keep an unused variable (gnu::used: GCC, Clang), so
    /// that a consumer's -Wglobal-constructors has nothing to report; an initializer that calls out, which
    /// is emitted unused, elsewhere (MSVC, which has no such warning). Measured: GCC 16.2.1 and Clang
    /// 22.1.8 keep the reference at -O0 and -O2, and MSVC 19.44 compiles either branch under /W4 /WX.
#if __has_cpp_attribute(gnu::used)
    [[gnu::used]] inline auto* const declarationContractsModeOfThisUnit = &declarationContractsMode;
#else
    inline int const declarationContractsModeOfThisUnit = declarationContractsMode();
#endif

} // namespace declaration_contracts_1

} // namespace isoline::meta::detail

namespace isoline::meta::detail
{

/// Refuses a declaration contract on a function that may throw, at compile time: the violation handler
/// an embedder installs may throw, and only a noexcept function ends the process where the check fails.
/// @tparam IsNoexcept Whether the function the contract is declared on is noexcept: a bool, as
///         std::meta::is_noexcept() answers the question, and the static_assert below asks it.
/// @return true, which the contract it is evaluated in then holds.
template <bool IsNoexcept>
consteval bool declarationContractOnNoexcept() noexcept
{
    static_assert(
        IsNoexcept,
        "ISOLINE_PRE/ISOLINE_POST need a noexcept member function: declare it noexcept, or keep the "
        "body check alone");
    return true;
}

/// Whether @p scope, a declaration contract's, is a class template's specialization, or a member function
/// of one: its contract is compiled with the template, in each consumer's translation unit, under the
/// consumer's semantic. An instantiated member's contract sees its class as its scope (measured, GCC
/// 16.2.1). Only a specialization the check instantiates is seen: a dependent contract is not evaluated
/// before its member function is, not even by the class's explicit instantiation (measured); the lint's
/// declaration-contract-inline rule refuses the rest by their text.
/// @param scope The contract's scope.
/// @return Whether it is such a class, or a member function of one.
consteval bool isOfClassTemplate(std::meta::info scope)
{
    if (std::meta::is_type(scope))
        return std::meta::has_template_arguments(scope);
    return std::meta::is_function(scope) && std::meta::has_template_arguments(std::meta::parent_of(scope));
}

/// Refuses a declaration contract on a member of a class template, at compile time.
/// @tparam IsOfClassTemplate Whether the contract is one's (isOfClassTemplate()): a bool, as the
///         static_assert below asks it.
/// @return true, which the contract it is evaluated in then holds.
template <bool IsOfClassTemplate>
consteval bool declarationContractOutsideClassTemplates() noexcept
{
    static_assert(!IsOfClassTemplate,
                  "ISOLINE_PRE/ISOLINE_POST stay off a class template's members: its consumers would compile "
                  "the check under their own semantic");
    return true;
}

} // namespace isoline::meta::detail

/// The proof: the function the contract is declared on is a noexcept member function, of no class
/// template. A member function's contract sees the function as its scope; a free function's sees its
/// namespace, which is no function, so it is refused too. A class template's member is refused by the
/// second assertion alone.
#define ISOLINE_DETAIL_NOEXCEPT_PROOF                                                                         \
    pre(::isoline::meta::detail::declarationContractOnNoexcept<                                               \
            std::meta::is_noexcept(std::meta::access_context::current().scope())                              \
            || ::isoline::meta::detail::isOfClassTemplate(std::meta::access_context::current().scope())>()    \
        && ::isoline::meta::detail::declarationContractOutsideClassTemplates<                                 \
            ::isoline::meta::detail::isOfClassTemplate(std::meta::access_context::current().scope())>())

/// ISOLINE_PRE, proven: `pre(condition)` behind the proof.
#define ISOLINE_PRE(condition) ISOLINE_DETAIL_NOEXCEPT_PROOF pre(condition)

/// ISOLINE_POST, proven: `post(result: condition)` behind the proof.
#define ISOLINE_POST(result, condition) ISOLINE_DETAIL_NOEXCEPT_PROOF post(result: condition)
