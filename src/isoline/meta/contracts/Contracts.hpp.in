// Generated by CMake from src/isoline/meta/contracts/Contracts.hpp.in, the native half of the seam
// (cmake/IsolineLanguageFeatures.cmake; docs/language-features.md, "Declaration contracts").
//
// This package's declaration contracts, fixed when it was built: ISOLINE_PRE and ISOLINE_POST are C++26
// `pre` and `post` specifiers here, in every translation unit that includes an Isoline header, so every
// first declaration reads the same everywhere. A translation unit compiled without contracts could not
// parse them, so it stops here, naming why; isoline::core's interface compiles its consumers as C++26,
// and the package's isolineConfig.cmake refuses another compiler before any of this is read. That every
// function carrying one is noexcept is proven where Isoline is built, by the reflection check
// isoline_declaration_contracts_check (src/isoline/meta/reflection/ContractsProof.hpp.in).
#pragma once

/// 1: this package's declarations carry C++26 contracts (ISOLINE_PRE and ISOLINE_POST expand).
#define ISOLINE_DECLARATION_CONTRACTS 1

#if !defined(__cpp_contracts)
    #error \
        "isoline was built with declaration contracts (ISOLINE_DECLARATION_CONTRACTS is 1): compile as C++26 with contracts enabled, as isoline::core asks"
#endif

namespace isoline::meta::detail
{

/// The mode's own namespace: a translation unit compiled against this header names the mode its package
/// was built in, so that objects of a native and a fallback package mixed in one program do not link.
inline namespace declaration_contracts_1
{

    /// The package's mode, ISOLINE_DECLARATION_CONTRACTS, as the library built in it defines it
    /// (src/isoline/Contracts.cpp); a library of the other mode defines another symbol.
    /// @return ISOLINE_DECLARATION_CONTRACTS.
    [[nodiscard]] int declarationContractsMode() noexcept;

    /// Read by every translation unit that sees a declaration contract (includes this header), so that each
    /// references the mode's symbol. Inside the mode's namespace, so that the two modes' copies are two
    /// names, and a linker that keeps one copy of each still keeps both references. A constant
    /// initializer where the compiler can be told to keep an unused variable (gnu::used: GCC, Clang), so
    /// that a consumer's -Wglobal-constructors has nothing to report; an initializer that calls out, which
    /// is emitted unused, elsewhere (MSVC, which has no such warning). Measured: GCC 16.2.1 and Clang
    /// 22.1.8 keep the reference at -O0 and -O2, and MSVC 19.44 compiles either branch under /W4 /WX.
#if __has_cpp_attribute(gnu::used)
    [[gnu::used]] inline auto* const declarationContractsModeOfThisUnit = &declarationContractsMode;
#else
    inline int const declarationContractsModeOfThisUnit = declarationContractsMode();
#endif

} // namespace declaration_contracts_1

} // namespace isoline::meta::detail

/// A precondition of a noexcept member function, on its first declaration: `pre(condition)`. The
/// condition only reads. The body check stays beside it, for the fallback path.
#define ISOLINE_PRE(condition) pre(condition)

/// A postcondition of a noexcept member function, on its first declaration: `post(result: condition)`,
/// @p result naming the returned value in @p condition. The condition only reads.
#define ISOLINE_POST(result, condition) post(result: condition)
