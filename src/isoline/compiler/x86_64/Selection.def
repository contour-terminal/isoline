// SPDX-License-Identifier: Apache-2.0
//
// x86-64's instruction selection table: one row per way of selecting an operation, grouped by root
// operation in Operations.def's order and tried in table order (Selector.hpp generates the enumerator and the
// row from each). Adding a pattern or a feature-gated form is adding a row here.
//
//   ISOLINE_SELECTION(Name, RootOperation, Pattern, Requires, Cost, Emitter)
//
// - Name: the SelectionRowId enumerator.
// - RootOperation: the intermediate::Operation it selects.
// - Pattern: what it asks of the operands (Pattern): Any, RhsConst32, RhsSingleUseLoad, AddressAddConst,
//   CompareIntoBranch, CompareIntoSelect.
// - Requires: the CPU feature the row needs (Sse41, Popcnt, Lzcnt, Bmi1), or Baseline. Every operation's last
//   row is its baseline: Baseline and Any, which every gated or folding row falls back to.
// - Cost: about how many instructions it emits, for the statistics.
// - Emitter: what emits it (an Emission): an EmitterKind with the forms, condition and parameter it reads.
//
// The file has no include guard; each includer defines ISOLINE_SELECTION.
//
// clang-format off

ISOLINE_SELECTION(Removed,           Removed,           Any,               Baseline, 0,  nothing())
ISOLINE_SELECTION(I32Const,          I32Const,          Any,               Baseline, 1,  special(Constant))
ISOLINE_SELECTION(I64Const,          I64Const,          Any,               Baseline, 1,  special(Constant))
ISOLINE_SELECTION(F32Const,          F32Const,          Any,               Baseline, 2,  of(FloatConstant, MovdXR))
ISOLINE_SELECTION(F64Const,          F64Const,          Any,               Baseline, 2,  of(FloatConstant, MovqXR))
ISOLINE_SELECTION(I32Eqz,            I32Eqz,            Any,               Baseline, 3,  testZero(Test32RR))
ISOLINE_SELECTION(I32EqImmediate,    I32Eq,             RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, Equal))
ISOLINE_SELECTION(I32Eq,             I32Eq,             Any,               Baseline, 3,  compare(Cmp32RR, Equal))
ISOLINE_SELECTION(I32NeImmediate,    I32Ne,             RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, NotEqual))
ISOLINE_SELECTION(I32Ne,             I32Ne,             Any,               Baseline, 3,  compare(Cmp32RR, NotEqual))
ISOLINE_SELECTION(I32LtSImmediate,   I32LtS,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, Less))
ISOLINE_SELECTION(I32LtS,            I32LtS,            Any,               Baseline, 3,  compare(Cmp32RR, Less))
ISOLINE_SELECTION(I32LtUImmediate,   I32LtU,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, Below))
ISOLINE_SELECTION(I32LtU,            I32LtU,            Any,               Baseline, 3,  compare(Cmp32RR, Below))
ISOLINE_SELECTION(I32GtSImmediate,   I32GtS,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, Greater))
ISOLINE_SELECTION(I32GtS,            I32GtS,            Any,               Baseline, 3,  compare(Cmp32RR, Greater))
ISOLINE_SELECTION(I32GtUImmediate,   I32GtU,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, Above))
ISOLINE_SELECTION(I32GtU,            I32GtU,            Any,               Baseline, 3,  compare(Cmp32RR, Above))
ISOLINE_SELECTION(I32LeSImmediate,   I32LeS,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, LessOrEqual))
ISOLINE_SELECTION(I32LeS,            I32LeS,            Any,               Baseline, 3,  compare(Cmp32RR, LessOrEqual))
ISOLINE_SELECTION(I32LeUImmediate,   I32LeU,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, BelowOrEqual))
ISOLINE_SELECTION(I32LeU,            I32LeU,            Any,               Baseline, 3,  compare(Cmp32RR, BelowOrEqual))
ISOLINE_SELECTION(I32GeSImmediate,   I32GeS,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp32RI, Cmp32RI8, GreaterOrEqual))
ISOLINE_SELECTION(I32GeS,            I32GeS,            Any,               Baseline, 3,  compare(Cmp32RR, GreaterOrEqual))
