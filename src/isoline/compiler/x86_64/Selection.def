ISOLINE_SELECTION(I64LeU,            I64LeU,            Any,               Baseline, 3,  compare(Cmp64RR, BelowOrEqual))
ISOLINE_SELECTION(I64GeSImmediate,   I64GeS,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp64RI, Cmp64RI8, GreaterOrEqual))
ISOLINE_SELECTION(I64GeS,            I64GeS,            Any,               Baseline, 3,  compare(Cmp64RR, GreaterOrEqual))
ISOLINE_SELECTION(I64GeUImmediate,   I64GeU,            RhsConst32,        Baseline, 3,  compareImmediate(Cmp64RI, Cmp64RI8, AboveOrEqual))
ISOLINE_SELECTION(I64GeU,            I64GeU,            Any,               Baseline, 3,  compare(Cmp64RR, AboveOrEqual))
