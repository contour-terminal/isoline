// SPDX-License-Identifier: Apache-2.0
//
// x86-64's encoding table: one row per instruction form, in Mnemonic order (Encoder.hpp generates the
// enumerator, the row and its operand slots from each). Adding an instruction is adding a row here; the
// encoder interprets the columns and has no code of any one instruction.
//
//   ISOLINE_ENCODING(Mnemonic, Form, Prefix, RexW, Opcode, ModRm, Immediate, Roles, "intel template")
//
// - Form: where the explicit operands go (FormTable): ModRM.reg, ModRM.rm, the opcode's low three bits, an
//   immediate, a rel32, or a condition code added to the opcode's last byte.
// - Prefix: the mandatory or operand-size prefix (Hex66, HexF2, HexF3), emitted before REX.
// - RexW: W1 for a 64-bit operand size.
// - Opcode: one to three bytes, escapes included.
// - ModRm: Register when ModRM.reg holds an operand, DigitN for an opcode extension /N, None without ModRM.
// - Immediate: the width of the immediate field (Bits8, Bits32, Bits64), or Relative32 for a rel32.
// - Roles: the explicit operands, in the Form's order, each with its kind and what the instruction does
//   with it; then the implicit ones, each a fixed register the encoding names without an operand (div's
//   rdx:rax, a shift count in cl, the stack pointer a push moves). encode() takes the explicit ones only.
// - Template: the instruction as Intel syntax (llvm-mc's) spells it, {n} the n-th explicit operand;
//   intendedText() renders it, and scripts/check-encodings.py checks llvm-mc reads the bytes as it.
//
// The file has no include guard; each includer defines ISOLINE_ENCODING.
//
// clang-format off

// Integer ALU: add, or, and, sub, xor, cmp, each register-register (the MR form), register-memory, and with
// a 32-bit or a sign-extended 8-bit immediate.
ISOLINE_ENCODING(Add64RR,  ModRmRegister,  None, W1, (0x01), Register, None,  (useDef(G64), use(G64)), "add {0}, {1}")
ISOLINE_ENCODING(Add32RR,  ModRmRegister,  None, W0, (0x01), Register, None,  (useDef(G32), use(G32)), "add {0}, {1}")
ISOLINE_ENCODING(Add64RM,  RegisterModRm,  None, W1, (0x03), Register, None,  (useDef(G64), use(M64)), "add {0}, {1}")
ISOLINE_ENCODING(Add32RM,  RegisterModRm,  None, W0, (0x03), Register, None,  (useDef(G32), use(M32)), "add {0}, {1}")
ISOLINE_ENCODING(Add64RI,  ModRmImmediate, None, W1, (0x81), Digit0,   Bits32, (useDef(G64), use(S32)), "add {0}, {1}")
ISOLINE_ENCODING(Add32RI,  ModRmImmediate, None, W0, (0x81), Digit0,   Bits32, (useDef(G32), use(U32)), "add {0}, {1}")
ISOLINE_ENCODING(Add64RI8, ModRmImmediate, None, W1, (0x83), Digit0,   Bits8,  (useDef(G64), use(S8)),  "add {0}, {1}")
ISOLINE_ENCODING(Add32RI8, ModRmImmediate, None, W0, (0x83), Digit0,   Bits8,  (useDef(G32), use(S8)),  "add {0}, {1}")
ISOLINE_ENCODING(Or64RR,   ModRmRegister,  None, W1, (0x09), Register, None,  (useDef(G64), use(G64)), "or {0}, {1}")
ISOLINE_ENCODING(Or32RR,   ModRmRegister,  None, W0, (0x09), Register, None,  (useDef(G32), use(G32)), "or {0}, {1}")
ISOLINE_ENCODING(Or64RM,   RegisterModRm,  None, W1, (0x0b), Register, None,  (useDef(G64), use(M64)), "or {0}, {1}")
ISOLINE_ENCODING(Or32RM,   RegisterModRm,  None, W0, (0x0b), Register, None,  (useDef(G32), use(M32)), "or {0}, {1}")
ISOLINE_ENCODING(Or64RI,   ModRmImmediate, None, W1, (0x81), Digit1,   Bits32, (useDef(G64), use(S32)), "or {0}, {1}")
ISOLINE_ENCODING(Or32RI,   ModRmImmediate, None, W0, (0x81), Digit1,   Bits32, (useDef(G32), use(U32)), "or {0}, {1}")
ISOLINE_ENCODING(Or64RI8,  ModRmImmediate, None, W1, (0x83), Digit1,   Bits8,  (useDef(G64), use(S8)),  "or {0}, {1}")
ISOLINE_ENCODING(Or32RI8,  ModRmImmediate, None, W0, (0x83), Digit1,   Bits8,  (useDef(G32), use(S8)),  "or {0}, {1}")
ISOLINE_ENCODING(And64RR,  ModRmRegister,  None, W1, (0x21), Register, None,  (useDef(G64), use(G64)), "and {0}, {1}")
ISOLINE_ENCODING(And32RR,  ModRmRegister,  None, W0, (0x21), Register, None,  (useDef(G32), use(G32)), "and {0}, {1}")
ISOLINE_ENCODING(And64RM,  RegisterModRm,  None, W1, (0x23), Register, None,  (useDef(G64), use(M64)), "and {0}, {1}")
ISOLINE_ENCODING(And32RM,  RegisterModRm,  None, W0, (0x23), Register, None,  (useDef(G32), use(M32)), "and {0}, {1}")
ISOLINE_ENCODING(And64RI,  ModRmImmediate, None, W1, (0x81), Digit4,   Bits32, (useDef(G64), use(S32)), "and {0}, {1}")
ISOLINE_ENCODING(And32RI,  ModRmImmediate, None, W0, (0x81), Digit4,   Bits32, (useDef(G32), use(U32)), "and {0}, {1}")
ISOLINE_ENCODING(And64RI8, ModRmImmediate, None, W1, (0x83), Digit4,   Bits8,  (useDef(G64), use(S8)),  "and {0}, {1}")
ISOLINE_ENCODING(And32RI8, ModRmImmediate, None, W0, (0x83), Digit4,   Bits8,  (useDef(G32), use(S8)),  "and {0}, {1}")
ISOLINE_ENCODING(Sub64RR,  ModRmRegister,  None, W1, (0x29), Register, None,  (useDef(G64), use(G64)), "sub {0}, {1}")
ISOLINE_ENCODING(Sub32RR,  ModRmRegister,  None, W0, (0x29), Register, None,  (useDef(G32), use(G32)), "sub {0}, {1}")
ISOLINE_ENCODING(Sub64RM,  RegisterModRm,  None, W1, (0x2b), Register, None,  (useDef(G64), use(M64)), "sub {0}, {1}")
ISOLINE_ENCODING(Sub32RM,  RegisterModRm,  None, W0, (0x2b), Register, None,  (useDef(G32), use(M32)), "sub {0}, {1}")
ISOLINE_ENCODING(Sub64RI,  ModRmImmediate, None, W1, (0x81), Digit5,   Bits32, (useDef(G64), use(S32)), "sub {0}, {1}")
ISOLINE_ENCODING(Sub32RI,  ModRmImmediate, None, W0, (0x81), Digit5,   Bits32, (useDef(G32), use(U32)), "sub {0}, {1}")
ISOLINE_ENCODING(Sub64RI8, ModRmImmediate, None, W1, (0x83), Digit5,   Bits8,  (useDef(G64), use(S8)),  "sub {0}, {1}")
ISOLINE_ENCODING(Sub32RI8, ModRmImmediate, None, W0, (0x83), Digit5,   Bits8,  (useDef(G32), use(S8)),  "sub {0}, {1}")
ISOLINE_ENCODING(Xor64RR,  ModRmRegister,  None, W1, (0x31), Register, None,  (useDef(G64), use(G64)), "xor {0}, {1}")
ISOLINE_ENCODING(Xor32RR,  ModRmRegister,  None, W0, (0x31), Register, None,  (useDef(G32), use(G32)), "xor {0}, {1}")
ISOLINE_ENCODING(Xor64RM,  RegisterModRm,  None, W1, (0x33), Register, None,  (useDef(G64), use(M64)), "xor {0}, {1}")
ISOLINE_ENCODING(Xor32RM,  RegisterModRm,  None, W0, (0x33), Register, None,  (useDef(G32), use(M32)), "xor {0}, {1}")
ISOLINE_ENCODING(Xor64RI,  ModRmImmediate, None, W1, (0x81), Digit6,   Bits32, (useDef(G64), use(S32)), "xor {0}, {1}")
ISOLINE_ENCODING(Xor32RI,  ModRmImmediate, None, W0, (0x81), Digit6,   Bits32, (useDef(G32), use(U32)), "xor {0}, {1}")
ISOLINE_ENCODING(Xor64RI8, ModRmImmediate, None, W1, (0x83), Digit6,   Bits8,  (useDef(G64), use(S8)),  "xor {0}, {1}")
ISOLINE_ENCODING(Xor32RI8, ModRmImmediate, None, W0, (0x83), Digit6,   Bits8,  (useDef(G32), use(S8)),  "xor {0}, {1}")
ISOLINE_ENCODING(Cmp64RR,  ModRmRegister,  None, W1, (0x39), Register, None,  (use(G64), use(G64)),    "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp32RR,  ModRmRegister,  None, W0, (0x39), Register, None,  (use(G32), use(G32)),    "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp64RM,  RegisterModRm,  None, W1, (0x3b), Register, None,  (use(G64), use(M64)),    "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp32RM,  RegisterModRm,  None, W0, (0x3b), Register, None,  (use(G32), use(M32)),    "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp64RI,  ModRmImmediate, None, W1, (0x81), Digit7,   Bits32, (use(G64), use(S32)),    "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp32RI,  ModRmImmediate, None, W0, (0x81), Digit7,   Bits32, (use(G32), use(U32)),    "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp64RI8, ModRmImmediate, None, W1, (0x83), Digit7,   Bits8,  (use(G64), use(S8)),     "cmp {0}, {1}")
ISOLINE_ENCODING(Cmp32RI8, ModRmImmediate, None, W0, (0x83), Digit7,   Bits8,  (use(G32), use(S8)),     "cmp {0}, {1}")
// The poll's `cmp byte ptr [flag], 0`.
ISOLINE_ENCODING(Cmp8MI,   ModRmImmediate, None, W0, (0x80), Digit7,   Bits8,  (use(M8), use(S8)),      "cmp {0}, {1}")

// test; Test64MR is the stack probe's touch of each page.
ISOLINE_ENCODING(Test64RR, ModRmRegister,  None, W1, (0x85), Register, None,  (use(G64), use(G64)), "test {0}, {1}")
ISOLINE_ENCODING(Test32RR, ModRmRegister,  None, W0, (0x85), Register, None,  (use(G32), use(G32)), "test {0}, {1}")
ISOLINE_ENCODING(Test64RI, ModRmImmediate, None, W1, (0xf7), Digit0,   Bits32, (use(G64), use(S32)), "test {0}, {1}")
ISOLINE_ENCODING(Test32RI, ModRmImmediate, None, W0, (0xf7), Digit0,   Bits32, (use(G32), use(U32)), "test {0}, {1}")
ISOLINE_ENCODING(Test64MR, ModRmRegister,  None, W1, (0x85), Register, None,  (use(M64), use(G64)), "test {0}, {1}")

// Multiplication, division and their sign extension of rax into rdx.
ISOLINE_ENCODING(Imul64RR,  RegisterModRm,          None, W1, (0x0f, 0xaf), Register, None,  (useDef(G64), use(G64)),        "imul {0}, {1}")
ISOLINE_ENCODING(Imul32RR,  RegisterModRm,          None, W0, (0x0f, 0xaf), Register, None,  (useDef(G32), use(G32)),        "imul {0}, {1}")
ISOLINE_ENCODING(Imul64RM,  RegisterModRm,          None, W1, (0x0f, 0xaf), Register, None,  (useDef(G64), use(M64)),        "imul {0}, {1}")
ISOLINE_ENCODING(Imul32RM,  RegisterModRm,          None, W0, (0x0f, 0xaf), Register, None,  (useDef(G32), use(M32)),        "imul {0}, {1}")
ISOLINE_ENCODING(Imul64RRI, RegisterModRmImmediate, None, W1, (0x69),       Register, Bits32, (def(G64), use(G64), use(S32)), "imul {0}, {1}, {2}")
ISOLINE_ENCODING(Imul32RRI, RegisterModRmImmediate, None, W0, (0x69),       Register, Bits32, (def(G32), use(G32), use(U32)), "imul {0}, {1}, {2}")
ISOLINE_ENCODING(Div64R,    ModRmOnly,              None, W1, (0xf7),       Digit6,   None,  (use(G64), implicitUseDef(Gpr::Rax), implicitUseDef(Gpr::Rdx)), "div {0}")
ISOLINE_ENCODING(Div32R,    ModRmOnly,              None, W0, (0xf7),       Digit6,   None,  (use(G32), implicitUseDef(Gpr::Rax), implicitUseDef(Gpr::Rdx)), "div {0}")
ISOLINE_ENCODING(Idiv64R,   ModRmOnly,              None, W1, (0xf7),       Digit7,   None,  (use(G64), implicitUseDef(Gpr::Rax), implicitUseDef(Gpr::Rdx)), "idiv {0}")
ISOLINE_ENCODING(Idiv32R,   ModRmOnly,              None, W0, (0xf7),       Digit7,   None,  (use(G32), implicitUseDef(Gpr::Rax), implicitUseDef(Gpr::Rdx)), "idiv {0}")
ISOLINE_ENCODING(Cqo,       ZeroOperands,           None, W1, (0x99),       None,     None,  (implicitUse(Gpr::Rax), implicitDef(Gpr::Rdx)), "cqo")
ISOLINE_ENCODING(Cdq,       ZeroOperands,           None, W0, (0x99),       None,     None,  (implicitUse(Gpr::Rax), implicitDef(Gpr::Rdx)), "cdq")
ISOLINE_ENCODING(Neg64R,    ModRmOnly,              None, W1, (0xf7),       Digit3,   None,  (useDef(G64)),                  "neg {0}")
ISOLINE_ENCODING(Neg32R,    ModRmOnly,              None, W0, (0xf7),       Digit3,   None,  (useDef(G32)),                  "neg {0}")
ISOLINE_ENCODING(Not64R,    ModRmOnly,              None, W1, (0xf7),       Digit2,   None,  (useDef(G64)),                  "not {0}")
ISOLINE_ENCODING(Not32R,    ModRmOnly,              None, W0, (0xf7),       Digit2,   None,  (useDef(G32)),                  "not {0}")

// Shifts and rotates, by cl or by an immediate count.
ISOLINE_ENCODING(Shl64RCl, ModRmOnly,      None, W1, (0xd3), Digit4, None,  (useDef(G64), implicitUse(Gpr::Rcx)), "shl {0}, cl")
ISOLINE_ENCODING(Shl32RCl, ModRmOnly,      None, W0, (0xd3), Digit4, None,  (useDef(G32), implicitUse(Gpr::Rcx)), "shl {0}, cl")
ISOLINE_ENCODING(Shl64RI8, ModRmImmediate, None, W1, (0xc1), Digit4, Bits8, (useDef(G64), use(U8)),               "shl {0}, {1}")
ISOLINE_ENCODING(Shl32RI8, ModRmImmediate, None, W0, (0xc1), Digit4, Bits8, (useDef(G32), use(U8)),               "shl {0}, {1}")
ISOLINE_ENCODING(Shr64RCl, ModRmOnly,      None, W1, (0xd3), Digit5, None,  (useDef(G64), implicitUse(Gpr::Rcx)), "shr {0}, cl")
ISOLINE_ENCODING(Shr32RCl, ModRmOnly,      None, W0, (0xd3), Digit5, None,  (useDef(G32), implicitUse(Gpr::Rcx)), "shr {0}, cl")
ISOLINE_ENCODING(Shr64RI8, ModRmImmediate, None, W1, (0xc1), Digit5, Bits8, (useDef(G64), use(U8)),               "shr {0}, {1}")
ISOLINE_ENCODING(Shr32RI8, ModRmImmediate, None, W0, (0xc1), Digit5, Bits8, (useDef(G32), use(U8)),               "shr {0}, {1}")
ISOLINE_ENCODING(Sar64RCl, ModRmOnly,      None, W1, (0xd3), Digit7, None,  (useDef(G64), implicitUse(Gpr::Rcx)), "sar {0}, cl")
ISOLINE_ENCODING(Sar32RCl, ModRmOnly,      None, W0, (0xd3), Digit7, None,  (useDef(G32), implicitUse(Gpr::Rcx)), "sar {0}, cl")
ISOLINE_ENCODING(Sar64RI8, ModRmImmediate, None, W1, (0xc1), Digit7, Bits8, (useDef(G64), use(U8)),               "sar {0}, {1}")
ISOLINE_ENCODING(Sar32RI8, ModRmImmediate, None, W0, (0xc1), Digit7, Bits8, (useDef(G32), use(U8)),               "sar {0}, {1}")
ISOLINE_ENCODING(Rol64RCl, ModRmOnly,      None, W1, (0xd3), Digit0, None,  (useDef(G64), implicitUse(Gpr::Rcx)), "rol {0}, cl")
ISOLINE_ENCODING(Rol32RCl, ModRmOnly,      None, W0, (0xd3), Digit0, None,  (useDef(G32), implicitUse(Gpr::Rcx)), "rol {0}, cl")
ISOLINE_ENCODING(Rol64RI8, ModRmImmediate, None, W1, (0xc1), Digit0, Bits8, (useDef(G64), use(U8)),               "rol {0}, {1}")
ISOLINE_ENCODING(Rol32RI8, ModRmImmediate, None, W0, (0xc1), Digit0, Bits8, (useDef(G32), use(U8)),               "rol {0}, {1}")
ISOLINE_ENCODING(Ror64RCl, ModRmOnly,      None, W1, (0xd3), Digit1, None,  (useDef(G64), implicitUse(Gpr::Rcx)), "ror {0}, cl")
ISOLINE_ENCODING(Ror32RCl, ModRmOnly,      None, W0, (0xd3), Digit1, None,  (useDef(G32), implicitUse(Gpr::Rcx)), "ror {0}, cl")
ISOLINE_ENCODING(Ror64RI8, ModRmImmediate, None, W1, (0xc1), Digit1, Bits8, (useDef(G64), use(U8)),               "ror {0}, {1}")
ISOLINE_ENCODING(Ror32RI8, ModRmImmediate, None, W0, (0xc1), Digit1, Bits8, (useDef(G32), use(U8)),               "ror {0}, {1}")

// Bit counts: lzcnt (LZCNT), tzcnt (BMI1) and popcnt (POPCNT), and the baseline bsr and bsf their fallback
// rows use.
ISOLINE_ENCODING(Lzcnt64RR,  RegisterModRm, HexF3, W1, (0x0f, 0xbd), Register, None, (def(G64), use(G64)), "lzcnt {0}, {1}")
ISOLINE_ENCODING(Lzcnt32RR,  RegisterModRm, HexF3, W0, (0x0f, 0xbd), Register, None, (def(G32), use(G32)), "lzcnt {0}, {1}")
ISOLINE_ENCODING(Tzcnt64RR,  RegisterModRm, HexF3, W1, (0x0f, 0xbc), Register, None, (def(G64), use(G64)), "tzcnt {0}, {1}")
ISOLINE_ENCODING(Tzcnt32RR,  RegisterModRm, HexF3, W0, (0x0f, 0xbc), Register, None, (def(G32), use(G32)), "tzcnt {0}, {1}")
ISOLINE_ENCODING(Popcnt64RR, RegisterModRm, HexF3, W1, (0x0f, 0xb8), Register, None, (def(G64), use(G64)), "popcnt {0}, {1}")
ISOLINE_ENCODING(Popcnt32RR, RegisterModRm, HexF3, W0, (0x0f, 0xb8), Register, None, (def(G32), use(G32)), "popcnt {0}, {1}")
ISOLINE_ENCODING(Bsr64RR,    RegisterModRm, None,  W1, (0x0f, 0xbd), Register, None, (def(G64), use(G64)), "bsr {0}, {1}")
ISOLINE_ENCODING(Bsr32RR,    RegisterModRm, None,  W0, (0x0f, 0xbd), Register, None, (def(G32), use(G32)), "bsr {0}, {1}")
ISOLINE_ENCODING(Bsf64RR,    RegisterModRm, None,  W1, (0x0f, 0xbc), Register, None, (def(G64), use(G64)), "bsf {0}, {1}")
ISOLINE_ENCODING(Bsf32RR,    RegisterModRm, None,  W0, (0x0f, 0xbc), Register, None, (def(G32), use(G32)), "bsf {0}, {1}")

// Moves between registers, from and to memory, and of immediates; lea.
ISOLINE_ENCODING(Mov64RR,   ModRmRegister,           None,  W1, (0x89), Register, None,  (def(G64), use(G64)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov32RR,   ModRmRegister,           None,  W0, (0x89), Register, None,  (def(G32), use(G32)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov64RM,   RegisterModRm,           None,  W1, (0x8b), Register, None,  (def(G64), use(M64)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov32RM,   RegisterModRm,           None,  W0, (0x8b), Register, None,  (def(G32), use(M32)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov64MR,   ModRmRegister,           None,  W1, (0x89), Register, None,  (use(M64), use(G64)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov32MR,   ModRmRegister,           None,  W0, (0x89), Register, None,  (use(M32), use(G32)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov16MR,   ModRmRegister,           Hex66, W0, (0x89), Register, None,  (use(M16), use(G16)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov8MR,    ModRmRegister,           None,  W0, (0x88), Register, None,  (use(M8), use(G8)),   "mov {0}, {1}")
ISOLINE_ENCODING(Mov32RI,   OpcodeRegisterImmediate, None,  W0, (0xb8), None,     Bits32, (def(G32), use(U32)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov64RI,   OpcodeRegisterImmediate, None,  W1, (0xb8), None,     Bits64, (def(G64), use(S64)), "movabs {0}, {1}")
ISOLINE_ENCODING(Mov64RI32, ModRmImmediate,          None,  W1, (0xc7), Digit0,   Bits32, (def(G64), use(S32)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov64MI32, ModRmImmediate,          None,  W1, (0xc7), Digit0,   Bits32, (use(M64), use(S32)), "mov {0}, {1}")
ISOLINE_ENCODING(Mov32MI,   ModRmImmediate,          None,  W0, (0xc7), Digit0,   Bits32, (use(M32), use(U32)), "mov {0}, {1}")
// lea; with a rip-relative address, the jump-table sequence's first instruction:
// lea table, [rip + table]; movsxd offset, dword ptr [table + 4*index]; add table, offset; jmp table.
ISOLINE_ENCODING(Lea64RM,   RegisterModRm,           None,  W1, (0x8d), Register, None,  (def(G64), use(Address)), "lea {0}, {1}")

// Zero and sign extension, from registers and from memory.
ISOLINE_ENCODING(Movzx32R8,   RegisterModRm, None, W0, (0x0f, 0xb6), Register, None, (def(G32), use(G8)),  "movzx {0}, {1}")
ISOLINE_ENCODING(Movzx32R16,  RegisterModRm, None, W0, (0x0f, 0xb7), Register, None, (def(G32), use(G16)), "movzx {0}, {1}")
ISOLINE_ENCODING(Movzx32M8,   RegisterModRm, None, W0, (0x0f, 0xb6), Register, None, (def(G32), use(M8)),  "movzx {0}, {1}")
ISOLINE_ENCODING(Movzx32M16,  RegisterModRm, None, W0, (0x0f, 0xb7), Register, None, (def(G32), use(M16)), "movzx {0}, {1}")
ISOLINE_ENCODING(Movsx32R8,   RegisterModRm, None, W0, (0x0f, 0xbe), Register, None, (def(G32), use(G8)),  "movsx {0}, {1}")
ISOLINE_ENCODING(Movsx64R8,   RegisterModRm, None, W1, (0x0f, 0xbe), Register, None, (def(G64), use(G8)),  "movsx {0}, {1}")
ISOLINE_ENCODING(Movsx32R16,  RegisterModRm, None, W0, (0x0f, 0xbf), Register, None, (def(G32), use(G16)), "movsx {0}, {1}")
ISOLINE_ENCODING(Movsx64R16,  RegisterModRm, None, W1, (0x0f, 0xbf), Register, None, (def(G64), use(G16)), "movsx {0}, {1}")
ISOLINE_ENCODING(Movsxd64R32, RegisterModRm, None, W1, (0x63),       Register, None, (def(G64), use(G32)), "movsxd {0}, {1}")
