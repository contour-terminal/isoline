// Parametric: select's operands are its two values, then the I32 condition.
ISOLINE_OPERATION(Select, "select", Select, SameAsOperand0, Pure, None)
// Replaces a NaN by the canonical NaN of its type, leaves every other value as it is (Deterministic).
ISOLINE_OPERATION(CanonicalizeNan, "canonicalize_nan", Float, SameAsOperand0, Pure, None)

// Memories. checkMemory(index, base, bound) traps unless index + offset + size <= bound, and returns the
// guarded effective address base + index + offset (0 under misspeculation, SpectreGuard::Enabled).
// guardAddress(address) is a dominated check's replacement: address + offset, 0 when address is 0.
ISOLINE_OPERATION(CheckMemory, "check_memory", CheckMemory, Pointer, MayTrap, MemoryAccess)
ISOLINE_OPERATION(GuardAddress, "guard_address", Pointer, Pointer, Pure, Offset)
ISOLINE_OPERATION(Load, "load", Pointer, FromImmediate, ReadsMemory, Load)
ISOLINE_OPERATION(Store, "store", Store, None, WritesMemory, StoreAccess)
ISOLINE_OPERATION(MemorySize, "memory_size", None, FromImmediate, ReadsContext, MemoryType)
ISOLINE_OPERATION(MemoryBase, "memory_base", None, Pointer, ReadsContext, Memory)
ISOLINE_OPERATION(MemoryBound, "memory_bound", None, I64, ReadsContext, Memory)

// Tables. checkTable(index) traps with its `trap` code unless index < the table's size, and returns the
// guarded address of the element.
ISOLINE_OPERATION(CheckTable, "check_table", Integer, Pointer, MayTrap, TableCheck)
ISOLINE_OPERATION(LoadTableElement, "load_table_element", Pointer, Ref, ReadsMemory, Table)
ISOLINE_OPERATION(StoreTableElement, "store_table_element", StoreReference, None, WritesMemory, Table)
ISOLINE_OPERATION(TableSize, "table_size", None, FromImmediate, ReadsContext, TableType)

// References: a Ref is one 64-bit word, kind | heap.kind << 8 | address << 32.
ISOLINE_OPERATION(RefNull, "ref.null", None, Ref, Pure, Heap)
ISOLINE_OPERATION(RefFunc, "ref.func", None, Ref, ReadsContext, Function)
ISOLINE_OPERATION(RefIsNull, "ref.is_null", Ref, I32, Pure, None)

// Globals, through their RawValue cells.
ISOLINE_OPERATION(LoadGlobal, "load_global", None, FromImmediate, ReadsMemory, GlobalType)
ISOLINE_OPERATION(StoreGlobal, "store_global", Any, None, WritesMemory, Global)

// The context values (the step countdown, memory 0's base and bound): loaded at entry and after every
// call or stub, the countdown stored back before every call, stub, exit and trap site.
ISOLINE_OPERATION(LoadContext, "load_context", None, FromImmediate, ReadsContext, ContextType)
ISOLINE_OPERATION(StoreContext, "store_context", Any, None, Poll, Context)

// The execution budget: poll(countdown) at a PollSite returns the countdown after it; pollStored polls
// the countdown the execution state holds, where a function's entry finds it (its caller stored it before
// the call), and leaves it there; enterFrame and leaveFrame charge and release a frame of `frameCost`
// stack values, after the call depth.
ISOLINE_OPERATION(Poll, "poll", I64, I64, Poll, PollSite)
ISOLINE_OPERATION(PollStored, "poll_stored", None, None, Poll, PollSite)
ISOLINE_OPERATION(EnterFrame, "enter_frame", None, None, Poll, FrameCost)
ISOLINE_OPERATION(LeaveFrame, "leave_frame", None, None, Poll, FrameCost)

// Calls: their operands are the arguments (call_indirect's first is the callee's table index), their
// results the callee's.
ISOLINE_OPERATION(Call, "call", Variadic, Multiple, Call, Function)
ISOLINE_OPERATION(CallIndirect, "call_indirect", IndexVariadic, Multiple, Call, CallIndirect)
ISOLINE_OPERATION(CallImport, "call_import", Variadic, Multiple, Call, Function)
ISOLINE_OPERATION(CallStub, "call_stub", Variadic, Multiple, Call, Stub)

// Traps with its `trap` code when its I32 condition is non-zero.
ISOLINE_OPERATION(TrapIf, "trap_if", I32, None, MayTrap, Trap)

// Terminators, one ending every block. A target is a (block, argumentCount) pair of immediates; the
// arguments of each target follow the fixed operands, target after target. switch's first target is its
// fallback, taken when the index is not below the number of the others.
ISOLINE_OPERATION(Jump, "jump", Variadic, None, Control, Jump)
ISOLINE_OPERATION(Branch, "branch", ConditionVariadic, None, Control, Branch)
ISOLINE_OPERATION(Switch, "switch", ConditionVariadic, None, Control, Switch)
ISOLINE_OPERATION(Return, "return", Variadic, None, Control, None)
ISOLINE_OPERATION(Trap, "trap", None, None, Control, Trap)
