// SPDX-License-Identifier: Apache-2.0
//
// The opcode table: every instruction Isoline decodes, one row each.
//
//     ISOLINE_OPCODE(Name, prefix, code, "text", Immediate, Signature, Proposal)
//
// Name       the Opcode enumerator.
// prefix     0x00 for a single-byte opcode, or the prefix byte (0xFC, 0xFD) of a prefixed one.
// code       the opcode byte, or the u32 sub-opcode that follows the prefix.
// "text"     the instruction's name in the text format; typed select, which shares "select" there,
//            is "select_t" after the spec's binary grammar (select t*), so every text is unique.
// Immediate  the ImmediateKind enumerator naming what follows the opcode.
// Signature  the OpcodeSignature enumerator naming its operand and result types, or Special where
//            typing it takes code: control, parametric, variable, table, memory and reference
//            instructions.
// Proposal   the Feature enumerator naming the proposal that introduced the instruction, which the
//            decoder requires enabled, or Mvp for an instruction of the MVP. Every row names one, so
//            a new row cannot decode ungated by accident.
//
// Adding an instruction is adding a row here: the Opcode enum, OpcodeTable and the lookup arrays
// are all generated from it. The file has no include guard; each includer defines ISOLINE_OPCODE.
//
// It holds every WebAssembly 2.0 instruction, SIMD's 236 included, and the wide-arithmetic
// proposal's four.

// Control instructions
ISOLINE_OPCODE(Unreachable, 0x00, 0x00, "unreachable", None, Special, Mvp)
ISOLINE_OPCODE(Nop, 0x00, 0x01, "nop", None, None, Mvp)
ISOLINE_OPCODE(Block, 0x00, 0x02, "block", BlockType, Special, Mvp)
ISOLINE_OPCODE(Loop, 0x00, 0x03, "loop", BlockType, Special, Mvp)
ISOLINE_OPCODE(If, 0x00, 0x04, "if", BlockType, Special, Mvp)
ISOLINE_OPCODE(Else, 0x00, 0x05, "else", None, Special, Mvp)
ISOLINE_OPCODE(End, 0x00, 0x0B, "end", None, Special, Mvp)
ISOLINE_OPCODE(Br, 0x00, 0x0C, "br", LabelIndex, Special, Mvp)
ISOLINE_OPCODE(BrIf, 0x00, 0x0D, "br_if", LabelIndex, Special, Mvp)
ISOLINE_OPCODE(BrTable, 0x00, 0x0E, "br_table", LabelTable, Special, Mvp)
ISOLINE_OPCODE(Return, 0x00, 0x0F, "return", None, Special, Mvp)
ISOLINE_OPCODE(Call, 0x00, 0x10, "call", FunctionIndex, Special, Mvp)
ISOLINE_OPCODE(CallIndirect, 0x00, 0x11, "call_indirect", CallIndirect, Special, Mvp)

// Parametric instructions
ISOLINE_OPCODE(Drop, 0x00, 0x1A, "drop", None, Special, Mvp)
ISOLINE_OPCODE(Select, 0x00, 0x1B, "select", None, Special, Mvp)
ISOLINE_OPCODE(SelectTyped, 0x00, 0x1C, "select_t", SelectTypes, Special, ReferenceTypes)

// Variable instructions
ISOLINE_OPCODE(LocalGet, 0x00, 0x20, "local.get", LocalIndex, Special, Mvp)
ISOLINE_OPCODE(LocalSet, 0x00, 0x21, "local.set", LocalIndex, Special, Mvp)
ISOLINE_OPCODE(LocalTee, 0x00, 0x22, "local.tee", LocalIndex, Special, Mvp)
ISOLINE_OPCODE(GlobalGet, 0x00, 0x23, "global.get", GlobalIndex, Special, Mvp)
ISOLINE_OPCODE(GlobalSet, 0x00, 0x24, "global.set", GlobalIndex, Special, Mvp)

// Table instructions
ISOLINE_OPCODE(TableGet, 0x00, 0x25, "table.get", TableIndex, Special, ReferenceTypes)
ISOLINE_OPCODE(TableSet, 0x00, 0x26, "table.set", TableIndex, Special, ReferenceTypes)

