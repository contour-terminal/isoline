// SPDX-License-Identifier: Apache-2.0
//
// The interpreter's operations: every operation lowered code holds, one row each.
//
//     ISOLINE_INTERPRETER_OPERATION(Name, "text", Form, Slots, Immediates, Family)
//
// Name        the OperationId enumerator.
// "text"      the operation's name in listings (describe()): a numeric operation's is its instruction's
//             name in the text format, and ".imm" ends that of a twin taking its right operand as an
//             immediate.
// Form        the OperationForm enumerator naming the layout of the operands after its header word.
// Slots       the number of its 32-bit slot operands, which follow the header two to a word, the
//             destination first.
// Immediates  the number of its 64-bit immediates, which follow the slot operands; a branch's last is its
//             target (BranchTargetMask).
// Family      the OperationFamily enumerator naming the operations it is executed with: which tail-call
//             handler file holds its handler, and whether the switch dispatch runs it inline or out of
//             line (OperationFamilyTable).
//
// An operation's size in code words is its header, its slot words and its immediates (OperationRow::words).
// Adding an operation is adding a row here: OperationId and OperationTable are generated from it.
// The file has no include guard; each includer defines ISOLINE_INTERPRETER_OPERATION.

// Control without operands
ISOLINE_INTERPRETER_OPERATION(Unreachable, "unreachable", Nullary, 0, 0, Control)
ISOLINE_INTERPRETER_OPERATION(Nop, "nop", Nullary, 0, 0, Control)

// Value moves and constants
ISOLINE_INTERPRETER_OPERATION(Move64, "move64", Move, 2, 0, Control)
ISOLINE_INTERPRETER_OPERATION(Move128, "move128", Move, 2, 0, Control)
ISOLINE_INTERPRETER_OPERATION(MoveRange, "move.range", Move, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(Const64, "const64", Move, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(Const128, "const128", Move, 1, 2, Control)

// Leaving the function: the slot of its first result, the rest following it
ISOLINE_INTERPRETER_OPERATION(Return, "return", Special, 1, 0, Control)

// Calls (CallTable): the slot of the first argument, where the callee's frame begins and its results come
// back to; then what names the callee: a code index of the caller's own module (call), a function index
// (call.import), the slot of a table index with the type and table indices (call_indirect), or the slot of a
// function reference with the type index (call_ref). Each return_call twin replaces the caller's frame.
ISOLINE_INTERPRETER_OPERATION(CallInternal, "call", Call, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(CallImport, "call.import", Call, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(CallIndirect, "call_indirect", Call, 2, 2, Control)
ISOLINE_INTERPRETER_OPERATION(CallRef, "call_ref", Call, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(ReturnCallInternal, "return_call", Call, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(ReturnCallImport, "return_call.import", Call, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(ReturnCallIndirect, "return_call_indirect", Call, 2, 2, Control)
ISOLINE_INTERPRETER_OPERATION(ReturnCallRef, "return_call_ref", Call, 2, 1, Control)

// Exceptions, out of line (throwException(), throwReference()): throw's payload's first slot and the tag's
// index in the module; throw_ref's slot of the exnref. Each is a site (LoweredFunction::sites), which
// unwinding starts from; a try_table emits no operation, its handler and catch clauses being records.
ISOLINE_INTERPRETER_OPERATION(Throw, "throw", Special, 1, 1, Exceptions)
ISOLINE_INTERPRETER_OPERATION(ThrowRef, "throw_ref", Special, 1, 0, Exceptions)

// Globals: a slot and the global's index in the module, whatever the global's type
ISOLINE_INTERPRETER_OPERATION(GlobalGet, "global.get", Special, 1, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(GlobalSet, "global.set", Special, 1, 1, Variable)

// Loads and stores of memory 0, one per scalar row of binary::MemoryAccessTable (LoweringRows): a Load's
// destination and address slots, a Store's address and value slots, then the static offset. Memory 0's
// bytes and size are the registers' (State::memory0); the bounds check is explicit. Each ".memory64" twin is
// the same access to a memory of i64 addresses, whose address and offset may overflow when added.
ISOLINE_INTERPRETER_OPERATION(I32Load, "i32.load", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32LoadMemory64, "i32.load.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load, "i64.load", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64LoadMemory64, "i64.load.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F32Load, "f32.load", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F32LoadMemory64, "f32.load.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F64Load, "f64.load", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F64LoadMemory64, "f64.load.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load8S, "i32.load8_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load8SMemory64, "i32.load8_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load8U, "i32.load8_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load8UMemory64, "i32.load8_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load16S, "i32.load16_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load16SMemory64, "i32.load16_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load16U, "i32.load16_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Load16UMemory64, "i32.load16_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load8S, "i64.load8_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load8SMemory64, "i64.load8_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load8U, "i64.load8_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load8UMemory64, "i64.load8_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load16S, "i64.load16_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load16SMemory64, "i64.load16_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load16U, "i64.load16_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load16UMemory64, "i64.load16_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load32S, "i64.load32_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load32SMemory64, "i64.load32_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load32U, "i64.load32_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Load32UMemory64, "i64.load32_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Store, "i32.store", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32StoreMemory64, "i32.store.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store, "i64.store", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64StoreMemory64, "i64.store.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F32Store, "f32.store", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F32StoreMemory64, "f32.store.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F64Store, "f64.store", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(F64StoreMemory64, "f64.store.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Store8, "i32.store8", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Store8Memory64, "i32.store8.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Store16, "i32.store16", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I32Store16Memory64, "i32.store16.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store8, "i64.store8", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store8Memory64, "i64.store8.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store16, "i64.store16", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store16Memory64, "i64.store16.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store32, "i64.store32", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(I64Store32Memory64, "i64.store32.memory64", Store, 2, 1, Memory)
// The vector loads and stores of memory 0, one per vector row of binary::MemoryAccessTable, alike: a load's
// destination, two slots, and its address; a store's address and its value's first slot; then the static
// offset. A lane access's lane index follows it: a lane load replaces that lane of the vector after the
// address, in the two slots above it (its home slots, where lowering moves it), and a lane store writes that
// lane.
ISOLINE_INTERPRETER_OPERATION(V128Load, "v128.load", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128LoadMemory64, "v128.load.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8x8S, "v128.load8x8_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8x8SMemory64, "v128.load8x8_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8x8U, "v128.load8x8_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8x8UMemory64, "v128.load8x8_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16x4S, "v128.load16x4_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16x4SMemory64, "v128.load16x4_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16x4U, "v128.load16x4_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16x4UMemory64, "v128.load16x4_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32x2S, "v128.load32x2_s", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32x2SMemory64, "v128.load32x2_s.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32x2U, "v128.load32x2_u", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32x2UMemory64, "v128.load32x2_u.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8Splat, "v128.load8_splat", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8SplatMemory64, "v128.load8_splat.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16Splat, "v128.load16_splat", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16SplatMemory64, "v128.load16_splat.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32Splat, "v128.load32_splat", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32SplatMemory64, "v128.load32_splat.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load64Splat, "v128.load64_splat", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load64SplatMemory64, "v128.load64_splat.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32Zero, "v128.load32_zero", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32ZeroMemory64, "v128.load32_zero.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load64Zero, "v128.load64_zero", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load64ZeroMemory64, "v128.load64_zero.memory64", Load, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8Lane, "v128.load8_lane", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load8LaneMemory64, "v128.load8_lane.memory64", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16Lane, "v128.load16_lane", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load16LaneMemory64, "v128.load16_lane.memory64", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32Lane, "v128.load32_lane", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load32LaneMemory64, "v128.load32_lane.memory64", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load64Lane, "v128.load64_lane", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Load64LaneMemory64, "v128.load64_lane.memory64", Load, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store, "v128.store", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128StoreMemory64, "v128.store.memory64", Store, 2, 1, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store8Lane, "v128.store8_lane", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store8LaneMemory64, "v128.store8_lane.memory64", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store16Lane, "v128.store16_lane", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store16LaneMemory64, "v128.store16_lane.memory64", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store32Lane, "v128.store32_lane", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store32LaneMemory64, "v128.store32_lane.memory64", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store64Lane, "v128.store64_lane", Store, 2, 2, Memory)
ISOLINE_INTERPRETER_OPERATION(V128Store64LaneMemory64, "v128.store64_lane.memory64", Store, 2, 2, Memory)
// A load or store of a memory other than memory 0, reached through the store: the slots of its memory 0
// twin, its static offset, then the memory, that twin and a lane access's lane (indexedAccessWord()), whose
// access it runs.
ISOLINE_INTERPRETER_OPERATION(LoadIndexed, "load.indexed", Load, 2, 2, Variable)
ISOLINE_INTERPRETER_OPERATION(StoreIndexed, "store.indexed", Store, 2, 2, Variable)
// memory.size: the destination slot and the memory's index. memory.grow: the result's slot, then the
// delta's, and the memory's index; it grows through the store and refreshes the registers' memory 0.
ISOLINE_INTERPRETER_OPERATION(MemorySize, "memory.size", Special, 1, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(MemoryGrow, "memory.grow", Special, 2, 1, Variable)
// The bulk operations: their destination's slot, their source's or value's, and their count's, each read at
// the width of the address type it is of (an i32 as 32 bits), then the indices they name, two to the word
// (indexPairWord()): memory.fill the memory; memory.copy the destination memory, then the source memory;
// memory.init the data segment, then the memory; and the table operations alike. Each checks its ranges
// before it writes anything, and polls before every granule (runtime::fillItems(), runtime::copyItems(),
// runtime::copySegment()). data.drop and elem.drop name their segment only.
ISOLINE_INTERPRETER_OPERATION(MemoryFill, "memory.fill", Bulk, 3, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(MemoryCopy, "memory.copy", Bulk, 3, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(MemoryInit, "memory.init", Bulk, 3, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(DataDrop, "data.drop", Special, 0, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(TableFill, "table.fill", Bulk, 3, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(TableCopy, "table.copy", Bulk, 3, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(TableInit, "table.init", Bulk, 3, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(ElemDrop, "elem.drop", Special, 0, 1, Variable)
// table.get: the destination slot and the index's, then the table's index. table.set: the index's slot and
// the reference's, then the table's index. Both read the element at the index elementChecked() masks.
// table.size: the destination slot and the table's index. table.grow: the result's slot, then the initial
// reference's and the delta's, and the table's index. An index, a size and a delta of a table of i32
// addresses are read and written as 32 bits.
ISOLINE_INTERPRETER_OPERATION(TableGet, "table.get", Special, 2, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(TableSet, "table.set", Special, 2, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(TableSize, "table.size", Special, 1, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(TableGrow, "table.grow", Special, 3, 1, Variable)
// ref.null: the destination slot and the heap as the module names it (heapWord()), which the running
// instance maps to its store's TypeId (nullSlots()). ref.func: the destination slot and the function's index.
ISOLINE_INTERPRETER_OPERATION(RefNull, "ref.null", Special, 1, 1, Variable)
ISOLINE_INTERPRETER_OPERATION(RefFunc, "ref.func", Special, 1, 1, Variable)
// ref.is_null: the destination slot and the reference's. ref.as_non_null: the destination slots and the
// reference's, which it moves there unless it traps with NullReference.
ISOLINE_INTERPRETER_OPERATION(RefIsNull, "ref.is_null", Unary, 2, 0, Control)
ISOLINE_INTERPRETER_OPERATION(RefAsNonNull, "ref.as_non_null", Unary, 2, 0, Control)
// select: the destination, the two values and the condition
ISOLINE_INTERPRETER_OPERATION(Select64, "select64", Special, 4, 0, Control)
ISOLINE_INTERPRETER_OPERATION(Select128, "select128", Special, 4, 0, Control)

// The vector operations: a v128 takes two slots, lane 0's bits first, and an operation names its first.
//
// An operator of a kernel shape (numerics::SimdShape) runs its numerics kernel, which lowering resolved once
// and wrote as the operation's last word: the destination slot and the operands' slots, then the kernel. A
// unary operator and a test take one vector, a binary operator two, a ternary three, a shift a vector and its
// i32 count.
ISOLINE_INTERPRETER_OPERATION(SimdUnary, "simd.unary", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(SimdBinary, "simd.binary", Special, 3, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(SimdTernary, "simd.ternary", Special, 4, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(SimdTest, "simd.test", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(SimdShift, "simd.shift", Special, 3, 1, Simd)
// The dedicated operators, which run the same numerics kernel inline (SimdInlineKernel): the destination slot
// and the operands' slots, as a Binary row lowers them.
ISOLINE_INTERPRETER_OPERATION(I32x4Add, "i32x4.add", Binary, 3, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(F32x4Mul, "f32x4.mul", Binary, 3, 0, Simd)
// i8x16.shuffle: the first operand's slots, which lowering moved it to and the result replaces, and the
// second operand's; then the 16 lane indices, eight bytes to the word, lane 0 lowest.
ISOLINE_INTERPRETER_OPERATION(I8x16Shuffle, "i8x16.shuffle", Special, 2, 2, Simd)
// The lane operations (SimdLaneTable): a splat's destination and its scalar's slot; an extract_lane's
// destination and its vector's slot, then the lane; a replace_lane's destination, its vector's and its
// scalar's slots, then the lane. A scalar of 32 bits is held zero-extended, an extracted i8 or i16 lane
// widened as its instruction says.
ISOLINE_INTERPRETER_OPERATION(I8x16Splat, "i8x16.splat", Special, 2, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(I16x8Splat, "i16x8.splat", Special, 2, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(I32x4Splat, "i32x4.splat", Special, 2, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(I64x2Splat, "i64x2.splat", Special, 2, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(F32x4Splat, "f32x4.splat", Special, 2, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(F64x2Splat, "f64x2.splat", Special, 2, 0, Simd)
ISOLINE_INTERPRETER_OPERATION(I8x16ExtractLaneS, "i8x16.extract_lane_s", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I8x16ExtractLaneU, "i8x16.extract_lane_u", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I16x8ExtractLaneS, "i16x8.extract_lane_s", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I16x8ExtractLaneU, "i16x8.extract_lane_u", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I32x4ExtractLane, "i32x4.extract_lane", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I64x2ExtractLane, "i64x2.extract_lane", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(F32x4ExtractLane, "f32x4.extract_lane", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(F64x2ExtractLane, "f64x2.extract_lane", Special, 2, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I8x16ReplaceLane, "i8x16.replace_lane", Special, 3, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I16x8ReplaceLane, "i16x8.replace_lane", Special, 3, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I32x4ReplaceLane, "i32x4.replace_lane", Special, 3, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(I64x2ReplaceLane, "i64x2.replace_lane", Special, 3, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(F32x4ReplaceLane, "f32x4.replace_lane", Special, 3, 1, Simd)
ISOLINE_INTERPRETER_OPERATION(F64x2ReplaceLane, "f64x2.replace_lane", Special, 3, 1, Simd)

// Wide arithmetic (WideArithmeticTable): the destination slot, whose result's low half it gets and the slot
// after it the high half, then the operands' slots: add128 and sub128 the low and high halves of each of
// their two operands, the multiplications their two i64.
ISOLINE_INTERPRETER_OPERATION(I64Add128, "i64.add128", Special, 5, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I64Sub128, "i64.sub128", Special, 5, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I64MulWideS, "i64.mul_wide_s", Special, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I64MulWideU, "i64.mul_wide_u", Special, 3, 0, Numeric)

// Numeric operations: one per numeric instruction, a destination slot and its operands' slots
ISOLINE_INTERPRETER_OPERATION(I32Eqz, "i32.eqz", Unary, 2, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32Eq, "i32.eq", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32Ne, "i32.ne", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32LtS, "i32.lt_s", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32LtU, "i32.lt_u", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32GtS, "i32.gt_s", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32GtU, "i32.gt_u", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32LeS, "i32.le_s", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32LeU, "i32.le_u", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32GeS, "i32.ge_s", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I32GeU, "i32.ge_u", Binary, 3, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I64Eqz, "i64.eqz", Unary, 2, 0, Numeric)
ISOLINE_INTERPRETER_OPERATION(I64Eq, "i64.eq", Binary, 3, 0, Numeric)
