ISOLINE_INTERPRETER_OPERATION(I32NeImmediateIf, "i32.ne.imm.if", Branch, 1, 2, Control)
ISOLINE_INTERPRETER_OPERATION(I32LtSBrIf, "i32.lt_s.br_if", Branch, 2, 1, Control)
