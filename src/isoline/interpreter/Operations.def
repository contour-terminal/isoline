// Control flow. A Branch operation's last immediate is its target, a word offset in the function's
// code; a ".loop" twin is the same transfer to a loop label, which polls (LoopPoll::Yes) before it
// jumps, at runtime::PollSite::LoopBackEdge through the executor's runtime::PollGate, never through the
// store directly. A BranchMove operation also moves the label's values when it branches: its slots are the
// condition, then the values' destination and source, and its last immediate holds the target in its
// low 32 bits and the values' slot count in its high 32 bits.
ISOLINE_INTERPRETER_OPERATION(Jump, "jump", Branch, 0, 1, Control)
ISOLINE_INTERPRETER_OPERATION(JumpLoop, "jump.loop", Branch, 0, 1, Control)
// if: continues at the target, the else branch or the end, when the condition is zero
ISOLINE_INTERPRETER_OPERATION(If, "if", Branch, 1, 1, Control)
// br_if: branches when the condition is not zero
ISOLINE_INTERPRETER_OPERATION(BrIf, "br_if", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrIfLoop, "br_if.loop", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrIfMove, "br_if.move", BranchMove, 3, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrIfMoveLoop, "br_if.move.loop", BranchMove, 3, 1, Control)
// br_on_null: branches when the reference is null
ISOLINE_INTERPRETER_OPERATION(BrOnNull, "br_on_null", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrOnNullLoop, "br_on_null.loop", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrOnNullMove, "br_on_null.move", BranchMove, 3, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrOnNullMoveLoop, "br_on_null.move.loop", BranchMove, 3, 1, Control)
// br_on_non_null: branches when the reference is not null
ISOLINE_INTERPRETER_OPERATION(BrOnNonNull, "br_on_non_null", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrOnNonNullLoop, "br_on_non_null.loop", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrOnNonNullMove, "br_on_non_null.move", BranchMove, 3, 1, Control)
ISOLINE_INTERPRETER_OPERATION(BrOnNonNullMoveLoop, "br_on_non_null.move.loop", BranchMove, 3, 1, Control)
// br_table: the index and the values' source slots, then the values' slot count and the number of labels
// before the default; one record of BranchTableEntryWords words per label follows, the default last
ISOLINE_INTERPRETER_OPERATION(BrTable, "br_table", BranchTable, 2, 2, Control)

// A comparison fused with the br_if or if that consumes its result (FusionTable): the comparison's operand
// slots, or for an ".imm" form its left operand's slot and its right operand as an immediate, then the
// target. Fused with if, it continues at the target when the comparison is false.
ISOLINE_INTERPRETER_OPERATION(I32EqzBrIf, "i32.eqz.br_if", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqzBrIfLoop, "i32.eqz.br_if.loop", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqzIf, "i32.eqz.if", Branch, 1, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqBrIf, "i32.eq.br_if", Branch, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqBrIfLoop, "i32.eq.br_if.loop", Branch, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqImmediateBrIf, "i32.eq.imm.br_if", Branch, 1, 2, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqImmediateBrIfLoop, "i32.eq.imm.br_if.loop", Branch, 1, 2, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqIf, "i32.eq.if", Branch, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32EqImmediateIf, "i32.eq.imm.if", Branch, 1, 2, Control)
ISOLINE_INTERPRETER_OPERATION(I32NeBrIf, "i32.ne.br_if", Branch, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32NeBrIfLoop, "i32.ne.br_if.loop", Branch, 2, 1, Control)
ISOLINE_INTERPRETER_OPERATION(I32NeImmediateBrIf, "i32.ne.imm.br_if", Branch, 1, 2, Control)
ISOLINE_INTERPRETER_OPERATION(I32NeImmediateBrIfLoop, "i32.ne.imm.br_if.loop", Branch, 1, 2, Control)
