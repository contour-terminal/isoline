/// The host stack one nested invocation takes, at the most, on one engine: what a host function that invokes
/// the guest again (HostContext::invoke()) adds below its caller's frames, measured on this build's flavour
/// with a margin. StoreLimits::maxNestedInvocations × this is what a thread running the store needs beyond
/// its outermost invocation (Calls.nestingStackCostIsPublished checks the measurement against it).
struct NestedInvocationRow
{
    ExecutionEngine engine; ///< The engine.
    std::size_t bytes;      ///< Its host stack per nested invocation.
};

/// The build flavour the rows were measured on: release, debug, address, thread or coverage, with the target
/// architecture appended for a target with a row of its own (release-s390x).
inline constexpr auto NestedInvocationFlavour = "@ISOLINE_NESTING_FLAVOUR@";

/// Every engine's row, for this build's flavour.
inline constexpr auto NestedInvocationTable = std::to_array<NestedInvocationRow>({
    { .engine = ExecutionEngine::Reference, .bytes = @ISOLINE_NESTING_REFERENCE_BYTES@ },
    { .engine = ExecutionEngine::Interpreter, .bytes = @ISOLINE_NESTING_INTERPRETER_BYTES@ },
});

/// The host stack one nested invocation on @p engine takes, at the most (NestedInvocationTable).
/// @param engine The engine; one with a row.
/// @return Its bytes; 0 for an engine without a row.
[[nodiscard]] constexpr std::size_t nestedInvocationBytes(ExecutionEngine engine) noexcept
{
    auto const row = std::ranges::find(NestedInvocationTable, engine, &NestedInvocationRow::engine);
    return row == NestedInvocationTable.end() ? 0 : row->bytes;
}

} // namespace isoline::runtime
