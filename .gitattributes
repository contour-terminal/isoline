# Every text file is checked out as LF, on every platform: tests compare checked-in text byte for byte,
# and the spec runner reports its diagnostics by line. A CRLF exception needs a reason, written beside it.
* text=auto eol=lf

# WebAssembly modules are binary.
*.wasm binary

# The vendored wasm-c-api copy is checked byte for byte against its MANIFEST: never converted.
vendor/wasm-c-api/** -text

# Fuzz inputs are bytes, whatever their extension: a text input too, which the text target reads byte for byte.
tests/fuzz/regressions/** binary
