{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "isoline-common",
            "hidden": true,
            "description": "Settings every developer and CI configuration shares",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "ISOLINE_TESTING": "ON",
                "ISOLINE_WERROR": "ON"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "not-windows",
            "hidden": true,
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-host",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "clang-common",
            "hidden": true,
            "inherits": [
                "isoline-common",
                "not-windows"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ISOLINE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "clang-asan",
            "displayName": "Clang Debug + ASan/UBSan",
            "inherits": [
                "clang-common",
                "debug"
            ],
            "cacheVariables": {
                "ISOLINE_SANITIZE": "address"
            }
        },
        {
            "name": "clang-tsan",
            "displayName": "Clang Debug + TSan",
            "inherits": [
                "clang-common",
                "debug"
            ],
            "cacheVariables": {
                "ISOLINE_SANITIZE": "thread"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "inherits": [
                "clang-common",
                "release"
            ]
        },
        {
            "name": "clang-coverage",
            "displayName": "Clang Debug + source-based coverage",
            "inherits": [
                "clang-common",
                "debug"
            ],
            "cacheVariables": {
                "ISOLINE_COVERAGE": "ON",
                "USE_COMPILER_CACHE": "OFF"
            }
        },
        {
            "name": "clang-libcxx-hardened",
            "displayName": "Clang Debug, libc++ in its fast hardening mode",
            "description": "libc++ checks its preconditions (a string_view's length, an index) and traps on a broken one: a host bug libstdc++ and ASan let pass, such as a view made longer than its bytes, ends the test. Catch2 is built here, since an installed one is built for libstdc++",
            "inherits": [
                "isoline-common",
                "linux-host",
                "debug"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++ -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
                "CMAKE_DISABLE_FIND_PACKAGE_Catch2": "ON",
                "ISOLINE_FETCH_DEPS": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "inherits": [
                "isoline-common",
                "not-windows",
                "debug"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "inherits": [
                "isoline-common",
                "not-windows",
                "release"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "macos-clang",
            "displayName": "Apple Clang Debug",
            "inherits": [
                "isoline-common",
                "debug"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cc",
                "CMAKE_CXX_COMPILER": "c++",
                "ISOLINE_FETCH_DEPS": "ON"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "description": "MSVC (64-bit); run from a Developer Command Prompt",
            "inherits": [
                "isoline-common",
                "debug"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "ISOLINE_FETCH_DEPS": "ON"
            }
        },
        {
            "name": "clangcl-cross-debug",
            "displayName": "Windows x64 cross (clang-cl) Debug",
            "description": "Windows x64 from Linux: clang-cl against an msvc-wine install; tests run under wine",
            "inherits": [
                "isoline-common",
                "linux-host",
                "debug"
            ],
            "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clangcl-cross.cmake",
            "cacheVariables": {
                "ISOLINE_FETCH_DEPS": "ON"
            }
        },
        {
            "name": "msvc-wine-debug",
            "displayName": "Windows x64 cross (MSVC under wine) Debug",
            "description": "Windows x64 from Linux: msvc-wine's cl.exe under wine, with the static CRT; tests run under wine",
            "inherits": [
                "isoline-common",
                "linux-host",
                "debug"
            ],
            "toolchainFile": "${sourceDir}/cmake/toolchains/windows-msvc-wine-cross.cmake",
            "cacheVariables": {
                "ISOLINE_FETCH_DEPS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },
        {
            "name": "clangcl-cross-release",
            "displayName": "Windows x64 cross (clang-cl) Release",
            "description": "Windows x64 from Linux: clang-cl against an msvc-wine install, release STL; tests run under wine",
            "inherits": [
                "isoline-common",
                "linux-host",
                "release"
            ],
            "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clangcl-cross.cmake",
            "cacheVariables": {
                "ISOLINE_FETCH_DEPS": "ON"
            }
        },
        {
            "name": "modules",
            "hidden": true,
            "description": "C++ modules on (ISOLINE_MODULES): the configure fails on a toolchain cmake/IsolineModuleSupport.cmake refuses",
            "cacheVariables": {
                "ISOLINE_MODULES": "ON"
            }
        },
        {
            "name": "clang-modules",
            "displayName": "Clang Debug + ASan/UBSan, C++ modules",
            "inherits": [
                "modules",
                "clang-asan"
            ]
        },
        {
            "name": "clang-modules-release",
            "displayName": "Clang Release, C++ modules",
            "inherits": [
                "modules",
                "clang-release"
            ]
        },
        {
            "name": "gcc-modules",
            "displayName": "GCC Debug, C++ modules",
            "inherits": [
                "modules",
                "gcc-debug"
            ]
        },
        {
            "name": "msvc-modules",
            "displayName": "MSVC Debug, C++ modules",
            "description": "MSVC (64-bit) with C++ modules; run from a Developer Command Prompt",
            "inherits": [
                "modules",
                "msvc-debug"
            ]
        },
        {
            "name": "msvc-modules-visual-studio",
            "displayName": "MSVC Debug, C++ modules, Visual Studio generator",
            "description": "MSVC (64-bit) with C++ modules, built in-tree by the Visual Studio 2026 generator, which picks the compiler and the configuration itself",
            "inherits": "msvc-modules",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": null,
                "CMAKE_BUILD_TYPE": null
            }
        },
        {
            "name": "msvc-wine-modules",
            "displayName": "Windows x64 cross (MSVC under wine) Debug, C++ modules",
            "description": "Windows x64 from Linux: msvc-wine's cl.exe under wine, with the static CRT and C++ modules; tests run under wine",
            "inherits": [
                "modules",
                "msvc-wine-debug"
            ]
        },
        {
            "name": "aarch64-cross-common",
            "hidden": true,
            "description": "Linux aarch64 from an x86_64 Linux host against a Debian sysroot; tests run under qemu-user",
            "inherits": [
                "isoline-common",
                "linux-host"
            ],
            "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu-clang.cmake",
            "cacheVariables": {
                "ISOLINE_FETCH_DEPS": "ON"
            }
        },
        {
            "name": "clang-aarch64-cross",
            "displayName": "Linux aarch64 cross (Clang) Debug",
            "inherits": [
                "aarch64-cross-common",
                "debug"
            ]
        },
        {
            "name": "clang-aarch64-cross-release",
            "displayName": "Linux aarch64 cross (Clang) Release",
            "inherits": [
                "aarch64-cross-common",
                "release"
            ]
        }
    ],
    "buildPresets": [
        { "name": "clang-asan", "configurePreset": "clang-asan" },
        { "name": "clang-tsan", "configurePreset": "clang-tsan" },
        { "name": "clang-release", "configurePreset": "clang-release" },
        { "name": "clang-coverage", "configurePreset": "clang-coverage" },
        {
            "name": "clang-libcxx-hardened",
            "configurePreset": "clang-libcxx-hardened",
            "description": "What the hardened-stdlib label's tests run",
            "targets": ["isoline_hardened_stdlib_tests"]
        },
        { "name": "gcc-debug", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "configurePreset": "gcc-release" },
        { "name": "macos-clang", "configurePreset": "macos-clang" },
        { "name": "msvc-debug", "configurePreset": "msvc-debug" },
        { "name": "clangcl-cross-debug", "configurePreset": "clangcl-cross-debug" },
        { "name": "msvc-wine-debug", "configurePreset": "msvc-wine-debug" },
        { "name": "clangcl-cross-release", "configurePreset": "clangcl-cross-release" },
        { "name": "clang-aarch64-cross", "configurePreset": "clang-aarch64-cross" },
        { "name": "clang-aarch64-cross-release", "configurePreset": "clang-aarch64-cross-release" },
        { "name": "clang-modules", "configurePreset": "clang-modules" },
        { "name": "clang-modules-release", "configurePreset": "clang-modules-release" },
        { "name": "gcc-modules", "configurePreset": "gcc-modules" },
        { "name": "msvc-modules", "configurePreset": "msvc-modules" },
        { "name": "msvc-modules-visual-studio", "configurePreset": "msvc-modules-visual-studio", "configuration": "Debug" },
        { "name": "msvc-wine-modules", "configurePreset": "msvc-wine-modules" }
    ],
    "testPresets": [
        {
            "name": "isoline-test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 900
            }
        },
        {
            "name": "isoline-test-common",
            "hidden": true,
            "inherits": "isoline-test-base",
            "description": "Every test but the perf label's, which asserts wall-clock latency and runs on request only",
            "filter": {
                "exclude": {
                    "label": "perf"
                }
            }
        },
        { "name": "clang-asan", "inherits": "isoline-test-common", "configurePreset": "clang-asan" },
        { "name": "clang-tsan", "inherits": "isoline-test-common", "configurePreset": "clang-tsan" },
        { "name": "clang-release", "inherits": "isoline-test-common", "configurePreset": "clang-release" },
        {
            "name": "clang-release-perf",
            "inherits": "isoline-test-base",
            "configurePreset": "clang-release",
            "description": "The perf label alone: the interrupt latency, measured in a release build on a quiet machine",
            "filter": {
                "include": {
                    "label": "perf"
                }
            }
        },
        {
            "name": "clang-coverage",
            "inherits": "isoline-test-common",
            "configurePreset": "clang-coverage",
            "description": "Every test, each process writing its profile to profiles/ for isoline_coverage_check",
            "environment": {
                "LLVM_PROFILE_FILE": "${sourceDir}/out/clang-coverage/profiles/%p.profraw"
            }
        },
        {
            "name": "clang-libcxx-hardened",
            "inherits": "isoline-test-base",
            "configurePreset": "clang-libcxx-hardened",
            "description": "The hardened-stdlib label alone: the tests whose host-input bounds a hardened libc++ holds to",
            "filter": {
                "include": {
                    "label": "hardened-stdlib"
                }
            }
        },
        { "name": "gcc-debug", "inherits": "isoline-test-common", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "inherits": "isoline-test-common", "configurePreset": "gcc-release" },
        { "name": "macos-clang", "inherits": "isoline-test-common", "configurePreset": "macos-clang" },
        { "name": "msvc-debug", "inherits": "isoline-test-common", "configurePreset": "msvc-debug" },
        { "name": "clangcl-cross-debug", "inherits": "isoline-test-common", "configurePreset": "clangcl-cross-debug" },
        { "name": "msvc-wine-debug", "inherits": "isoline-test-common", "configurePreset": "msvc-wine-debug" },
        { "name": "clangcl-cross-release", "inherits": "isoline-test-common", "configurePreset": "clangcl-cross-release" },
        { "name": "clang-aarch64-cross", "inherits": "isoline-test-common", "configurePreset": "clang-aarch64-cross" },
        { "name": "clang-aarch64-cross-release", "inherits": "isoline-test-common", "configurePreset": "clang-aarch64-cross-release" },
        { "name": "clang-modules", "inherits": "isoline-test-common", "configurePreset": "clang-modules" },
        { "name": "clang-modules-release", "inherits": "isoline-test-common", "configurePreset": "clang-modules-release" },
        { "name": "gcc-modules", "inherits": "isoline-test-common", "configurePreset": "gcc-modules" },
        { "name": "msvc-modules", "inherits": "isoline-test-common", "configurePreset": "msvc-modules" },
        { "name": "msvc-modules-visual-studio", "inherits": "isoline-test-common", "configurePreset": "msvc-modules-visual-studio", "configuration": "Debug" },
        { "name": "msvc-wine-modules", "inherits": "isoline-test-common", "configurePreset": "msvc-wine-modules" }
    ]
}
